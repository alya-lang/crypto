function leaf_cert_pem() -> string
    return "-----BEGIN CERTIFICATE-----\nMIIDFDCCAfygAwIBAgIUbpcF/6wifnCjm5xm0Gji4/3tx5UwDQYJKoZIhvcNAQEL\nBQAwFDESMBAGA1UEAwwJdGVzdC1yb290MB4XDTI2MDkyNjIxMzQwNFoXDTI2MDky\nODIxMzQwNFowFzEVMBMGA1UEAwwMbGVhZi5leGFtcGxlMIIBIjANBgkqhkiG9w0B\nAQEFAAOCAQ8AMIIBCgKCAQEArrjVQYm14uuYCV096pRtV7FQZGbnAGhGoUx7tRpR\niyW/i5ZK0Ib1mx244O/Z7x93k6GYpRyeThtck1Kpr4ObSthO451yDR+eTE7BbVsF\nlBYqDsE+pI9nhqAc5owrIYjz5NtdFLHYnMJ+bAXrTZ68agrqaKyBJ+m2FgEhNlGm\nv0B4J0v/4XRkxImoQrkAbWE8hzbNU0n+VgoYY/6hKiq+50M2/cMffkDoPrmLe0Y0\n1dkXuK4Nr2Ld+lPhIcsqgTUvhFo0I3rXgNG6Hla2k9SjM2OL1yFOx3qtqzj8xd8q\nXhHcdfhNEzpju7vZhfm2ejhP+OZcTx9yinZ/IUV61MpEJwIDAQABo1swWTAXBgNV\nHREEEDAOggxsZWFmLmV4YW1wbGUwHQYDVR0OBBYEFAoSNfXundhPl3cnE1+CB1k7\n23jsMB8GA1UdIwQYMBaAFIIPfj/nd7dGy9GAYARJ0ibTXoXmMA0GCSqGSIb3DQEB\nCwUAA4IBAQCUN6sviIXyYpTiPRwZD3eRhAyeyrM3Yeb0GhQZ5Mnl8ngE+HsoIinU\nZCZxVJsuR55riTK851/mYq1idIGOEQIIDMkFsHSx1lJ8/jlhilH+bJvX/ntgOjQy\nnabItq0+rIDXhH9sV4kuyY3WpRskrjghHWZXXQ4CplRmvh5PYgDeQkAWny010kzo\nl/rwyEhJtGPTP3PKxW7Y4/SSEN7sYpgcJxaw+H3JM6vOeTNWrUpRotT0o0HYnu0t\na9Z4R2SNdKAxT0Acl7oHUhz0dsscQzghPW6aihbtTKF+ai7cYdR60XQqkffk68ky\nvq0mJdM+DnQHJ0ER3GXGAAPKrmCOb7uD\n-----END CERTIFICATE-----\n"
end

function main()
    test_suite("RSA Tests")
    let r = runner_new()

    let self_der = crypto::pem_to_der(self_cert_pem(), "CERTIFICATE")
    runner_assert_eq(r, len(self_der), 779, "self-signed der length")
    let key = crypto::rsa_parse_pubkey(self_der)
    runner_assert_str_eq(r, key["error"], "", "pubkey parses")
    runner_assert_eq(r, len(key["n"]), 256, "modulus 256 bytes")
    runner_assert_eq(r, key["e"], 65537, "exponent 65537")

    let msg = [115, 105, 103, 110, 45, 109, 101]
    let sig = crypto::hex_to_bytes("")
    runner_assert_eq(r, crypto::rsa_verify(key["n"], key["e"], "sha256", msg, sig), 1, "openssl message signature verifies")
    let bad_msg = [115, 105, 103, 110, 45, 109, 102]
    runner_assert_eq(r, crypto::rsa_verify(key["n"], key["e"], "sha256", bad_msg, sig), 0, "tampered message rejected")
    runner_assert_eq(r, crypto::rsa_verify_cert(self_der, key["n"], key["e"]), 1, "self-signed cert verifies")

    let ca_der = crypto::pem_to_der(ca_cert_pem(), "CERTIFICATE")
    let leaf_der = crypto::pem_to_der(leaf_cert_pem(), "CERTIFICATE")
    let ca_key = crypto::rsa_parse_pubkey(ca_der)
    runner_assert_str_eq(r, ca_key["error"], "", "ca pubkey parses")
    runner_assert_eq(r, crypto::rsa_verify_cert(ca_der, ca_key["n"], ca_key["e"]), 1, "ca self-signature verifies")
    runner_assert_eq(r, crypto::rsa_verify_cert(leaf_der, ca_key["n"], ca_key["e"]), 1, "leaf verifies under ca key")
    let leaf_key = crypto::rsa_parse_pubkey(leaf_der)
    runner_assert_eq(r, crypto::rsa_verify_cert(leaf_der, leaf_key["n"], leaf_key["e"]), 0, "leaf self-signature correctly rejected")
    runner_assert_eq(r, crypto::rsa_verify_cert(leaf_der, key["n"], key["e"]), 0, "wrong issuer key rejected")

    let failed = runner_summary(r)
    if failed > 0
        exit(1)
    end
end

main()
