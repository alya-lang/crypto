    return "-----BEGIN CERTIFICATE-----\nMIIDCTCCAfGgAwIBAgIUHrtnC3L6K2jbkjSpkXt/c7jrdVIwDQYJKoZIhvcNAQEL\nBQAwFDESMBAGA1UEAwwJdGVzdC1yb290MB4XDTI2MDkyNjIxMzQwNFoXDTI2MDky\nOTIxMzQwNFowFDESMBAGA1UEAwwJdGVzdC1yb290MIIBIjANBgkqhkiG9w0BAQEF\nAAOCAQ8AMIIBCgKCAQEArxa+QzNPWff9JLthgVdJ8JpR5FjUssxemKe8xPTROgAy\nPHW5gbnnDRWwukU0aEImug7auAom+b+cCs6kWqAdloGZ+eUy8cy7+tbL9RC3lqe/\n586vQEkKxQKNfnNEZzZe932sZbAxuwg4/0JVXYAPHugqKEmX6aMgi00GBHA+52Jt\nHmYbWqE9bEy6EwOYkMWkLtNyFL9654ZOkxw1R1LauJeJhaQ6HdspIvY9d5jY9fjk\nVKX1uTq9oJ7c4acQ8FOPcSnIc6htE/tLlAUhoa+Tk1zCFtS8Fk0ZnqudHb7StPla\nrZ6CpZMRpM1NlLRpRpG2G34cAXo8AUnvMr7F3wusYQIDAQABo1MwUTAdBgNVHQ4E\nFgQUgg9+P+d3t0bL0YBgBEnSJtNeheYwHwYDVR0jBBgwFoAUgg9+P+d3t0bL0YBg\nBEnSJtNeheYwDwYDVR0TAQH/BAUwAwEB/zANBgkqhkiG9w0BAQsFAAOCAQEADRrj\nsKM8W7fBO2wmO5jwtn9U0MoVUAz1M0lrt5vnVkLzWnPbRn+du5VUgyCikW4n1nZA\n6xfypw0bvd5OysEnd9rFGCzstjYHXTzRDJjgw1IMDNPw9q1IwNEMhHBxzNX0uQ+M\nym1kEv/LEY2W1iIYTxVJOoEGBiUJpOlBciBaOjMskJFCZ4E3oiPmGzo3g9ZumcfN\nh+sdQGKvhq/germVm7x2cCGewF5QTlRjth2SPlV1ylYcOcbMIsePidV6l2+y0FXi\nA1sh1HGROg5c7jj02sxYBc/FRHIVwkyUegdZ0rsXbNqNcjGUYBtqslTCXcUDUIzr\nUzoZ9fgbLKPEyzw6GQ==\n-----END CERTIFICATE-----\n"
