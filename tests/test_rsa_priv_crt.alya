@cfg(feature = "math")
function main()
    test_suite("RSA Private CRT Tests")
    let r = runner_new()

    let key = crypto::rsa_parse_private_key(crypto::pem_to_der(priv_pem(), "PRIVATE KEY"))
    let ct = crypto::hex_to_bytes("")
    let crt = crypto::rsa_decrypt_crt_bytes(key, ct)
    runner_assert_str_eq(r, crt["error"], "", "CRT path decrypts 2048-bit")
    runner_assert_str_eq(r, crypto::bytes_to_str(crt["plaintext"]), "decrypt-me-please", "CRT plaintext matches")
    let failed = runner_summary(r)
    if failed > 0
        exit(1)
    end
end

# Without the gated features there is nothing to exercise: register
# an empty suite so the file still compiles and passes in slim views.
@cfg(not(feature = "math"))
function main()
    test_suite("RSA Private CRT Tests (skipped without features)")
    let r = runner_new()
    let failed = runner_summary(r)
    if failed > 0
        exit(1)
    end
end

main()
