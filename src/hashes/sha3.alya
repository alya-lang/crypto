## SHA-3 (FIPS 202) and Keccak Hash Family
##
## Part of the Alya Language package ecosystem (https://github.com/alya-lang).
## Sponge-construction Keccak-p[1600, 24] permutation hash algorithms.

import "../core/bits.alya"
import "../core/security.alya"
import "../encodings/hex.alya"

## Returns the lower 32 bits of Keccak round constants.
pub function _get_keccak_rc_lo() -> array
    return [
        1, 32898, 32906, 2147516416,
        32907, 2147483649, 2147516545, 32777,
        138, 136, 2147516425, 2147483658,
        2147516555, 139, 32905, 32771,
        32770, 128, 32778, 2147483658,
        2147516545, 32896, 2147483649, 2147516424
    ]
end

## Returns the upper 32 bits of Keccak round constants.
pub function _get_keccak_rc_hi() -> array
    return [
        0, 0, 2147483648, 2147483648,
        0, 0, 2147483648, 2147483648,
        0, 0, 0, 0,
        0, 2147483648, 2147483648, 2147483648,
        2147483648, 2147483648, 0, 2147483648,
        2147483648, 2147483648, 0, 2147483648
    ]
end

## Returns the Keccak rotation offsets.
pub function _get_keccak_r() -> array
    return [
        0, 36, 3, 41, 18,
        1, 44, 10, 45, 2,
        62, 6, 43, 15, 61,
        28, 55, 25, 21, 56,
        27, 20, 39, 8, 14
    ]
end

## Performs a 64-bit rotate left across two 32-bit registers (lo, hi).
pub function _rotl64_split(lo: int, hi: int, n: int) -> array
    if n == 0
        return [lo, hi]
    end
    if n == 32
        return [hi, lo]
    end
    if n < 32
        let r_lo = bit_and(bit_or(bit_shl(lo, n), bit_shr(hi, 32 - n)), 4294967295)
        let r_hi = bit_and(bit_or(bit_shl(hi, n), bit_shr(lo, 32 - n)), 4294967295)
        return [r_lo, r_hi]
    end
    let m = n - 32
    let r_lo = bit_and(bit_or(bit_shl(hi, m), bit_shr(lo, 32 - m)), 4294967295)
    let r_hi = bit_and(bit_or(bit_shl(lo, m), bit_shr(hi, 32 - m)), 4294967295)
    return [r_lo, r_hi]
end

## Applies the Keccak-f[1600] permutation using dual 32-bit lanes.
pub function _keccak_f1600(a_lo: array, a_hi: array)
    let rc_lo = _get_keccak_rc_lo()
    let rc_hi = _get_keccak_rc_hi()
    let r_table = _get_keccak_r()

    let round = 0
    while round < 24
        # 1. Theta
        let c_lo = []
        let c_hi = []
        let x = 0
        while x < 5
            let v_lo = bit_xor(bit_xor(bit_xor(bit_xor(a_lo[x], a_lo[x + 5]), a_lo[x + 10]), a_lo[x + 15]), a_lo[x + 20])
            let v_hi = bit_xor(bit_xor(bit_xor(bit_xor(a_hi[x], a_hi[x + 5]), a_hi[x + 10]), a_hi[x + 15]), a_hi[x + 20])
            c_lo.push(v_lo)
            c_hi.push(v_hi)
            x += 1
        end

        let d_lo = []
        let d_hi = []
        x = 0
        while x < 5
            let prev_idx = (x + 4) % 5
            let next_idx = (x + 1) % 5
            let rot_next = _rotl64_split(c_lo[next_idx], c_hi[next_idx], 1)
            d_lo.push(bit_xor(c_lo[prev_idx], rot_next[0]))
            d_hi.push(bit_xor(c_hi[prev_idx], rot_next[1]))
            x += 1
        end

        x = 0
        while x < 5
            let y = 0
            while y < 5
                let idx = x + y * 5
                a_lo[idx] = bit_xor(a_lo[idx], d_lo[x])
                a_hi[idx] = bit_xor(a_hi[idx], d_hi[x])
                y += 1
            end
            x += 1
        end

        # 2. Rho and Pi
        let b_lo = []
        let b_hi = []
        let idx = 0
        while idx < 25
            b_lo.push(0)
            b_hi.push(0)
            idx += 1
        end

        x = 0
        while x < 5
            let y = 0
            while y < 5
                let rot_amount = r_table[x * 5 + y]
                let src_idx = x + y * 5
                let rot_val = _rotl64_split(a_lo[src_idx], a_hi[src_idx], rot_amount)
                let new_x = y
                let new_y = (2 * x + 3 * y) % 5
                let dst_idx = new_x + new_y * 5
                b_lo[dst_idx] = rot_val[0]
                b_hi[dst_idx] = rot_val[1]
                y += 1
            end
            x += 1
        end

        # 3. Chi
        x = 0
        while x < 5
            let y = 0
            while y < 5
                let cur_idx = x + y * 5
                let next1_idx = ((x + 1) % 5) + y * 5
                let next2_idx = ((x + 2) % 5) + y * 5

                let not_b1_lo = bit_xor(b_lo[next1_idx], 4294967295)
                let not_b1_hi = bit_xor(b_hi[next1_idx], 4294967295)

                a_lo[cur_idx] = bit_xor(b_lo[cur_idx], bit_and(not_b1_lo, b_lo[next2_idx]))
                a_hi[cur_idx] = bit_xor(b_hi[cur_idx], bit_and(not_b1_hi, b_hi[next2_idx]))
                y += 1
            end
            x += 1
        end

        # 4. Iota
        a_lo[0] = bit_xor(a_lo[0], rc_lo[round])
        a_hi[0] = bit_xor(a_hi[0], rc_hi[round])

        round += 1
    end
end

## Runs the sponge engine producing out_len bytes.
pub function _sha3_engine(msg_bytes, rate_bytes, suffix: int, out_len: int) -> array
    let padded = []
    let mlen = len(msg_bytes)
    let i = 0
    while i < mlen
        padded.push(msg_bytes[i])
        i += 1
    end

    # Pad with suffix and 0x80 (10*1 padding)
    padded.push(suffix)
    while len(padded) % rate_bytes != (rate_bytes - 1)
        padded.push(0)
    end
    padded.push(128)

    let a_lo = []
    let a_hi = []
    i = 0
    while i < 25
        a_lo.push(0)
        a_hi.push(0)
        i += 1
    end

    let offset = 0
    let plen = len(padded)
    while offset < plen
        let w = 0
        let words_in_block = rate_bytes / 8
        while w < words_in_block
            let b0 = padded[offset + w * 8]
            let b1 = padded[offset + w * 8 + 1]
            let b2 = padded[offset + w * 8 + 2]
            let b3 = padded[offset + w * 8 + 3]
            let b4 = padded[offset + w * 8 + 4]
            let b5 = padded[offset + w * 8 + 5]
            let b6 = padded[offset + w * 8 + 6]
            let b7 = padded[offset + w * 8 + 7]

            let lo = bit_or(bit_or(b0, bit_shl(b1, 8)), bit_or(bit_shl(b2, 16), bit_shl(b3, 24)))
            let hi = bit_or(bit_or(b4, bit_shl(b5, 8)), bit_or(bit_shl(b6, 16), bit_shl(b7, 24)))

            let x = w % 5
            let y = w / 5
            let idx = x + y * 5
            a_lo[idx] = bit_xor(a_lo[idx], lo)
            a_hi[idx] = bit_xor(a_hi[idx], hi)
            w += 1
        end

        _keccak_f1600(a_lo, a_hi)
        offset += rate_bytes
    end

    let out = []
    let w = 0
    while len(out) < out_len
        let x = w % 5
        let y = w / 5
        let idx = x + y * 5
        let lo = a_lo[idx]
        let hi = a_hi[idx]

        let bytes_word = [
            bit_and(lo, 255),
            bit_and(bit_shr(lo, 8), 255),
            bit_and(bit_shr(lo, 16), 255),
            bit_and(bit_shr(lo, 24), 255),
            bit_and(hi, 255),
            bit_and(bit_shr(hi, 8), 255),
            bit_and(bit_shr(hi, 16), 255),
            bit_and(bit_shr(hi, 24), 255)
        ]

        let b_idx = 0
        while b_idx < 8 and len(out) < out_len
            out.push(bytes_word[b_idx])
            b_idx += 1
        end
        w += 1
    end

    return out
end

## Computes SHA3-256 hash of a byte array, returning 32 raw bytes.
##
## ### Parameters
## - `msg_bytes`: Input byte array integers `[0..255]`.
##
## ### Returns
## 32-element byte array containing the digest.
pub function sha3_256_bytes(msg_bytes) -> array
    return _sha3_engine(msg_bytes, 136, 6, 32)
end

## Computes SHA3-256 hash of an Alya string, returning lowercase hex.
##
## ### Parameters
## - `msg_str`: Input string.
##
## ### Returns
## 64-character lowercase hex digest string.
pub function sha3_256(msg_str: str) -> str
    let b = str_to_bytes(msg_str)
    let res = sha3_256_bytes(b)
    return bytes_to_hex(res)
end

## Computes SHA3-512 hash of a byte array, returning 64 raw bytes.
##
## ### Parameters
## - `msg_bytes`: Input byte array integers `[0..255]`.
##
## ### Returns
## 64-element byte array containing the digest.
pub function sha3_512_bytes(msg_bytes) -> array
    return _sha3_engine(msg_bytes, 72, 6, 64)
end

## Computes SHA3-512 hash of an Alya string, returning lowercase hex.
##
## ### Parameters
## - `msg_str`: Input string.
##
## ### Returns
## 128-character lowercase hex digest string.
pub function sha3_512(msg_str: str) -> str
    let b = str_to_bytes(msg_str)
    let res = sha3_512_bytes(b)
    return bytes_to_hex(res)
end

## Computes Keccak-256 (Ethereum / Web3 standard) hash of a byte array.
##
## ### Parameters
## - `msg_bytes`: Input byte array integers `[0..255]`.
##
## ### Returns
## 32-element byte array containing the digest.
pub function keccak_256_bytes(msg_bytes) -> array
    return _sha3_engine(msg_bytes, 136, 1, 32)
end

## Computes Keccak-256 (Ethereum / Web3 standard) hash of an Alya string.
##
## ### Parameters
## - `msg_str`: Input string.
##
## ### Returns
## 64-character lowercase hex digest string.
pub function keccak_256(msg_str: str) -> str
    let b = str_to_bytes(msg_str)
    let res = keccak_256_bytes(b)
    return bytes_to_hex(res)
end
