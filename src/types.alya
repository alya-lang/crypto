## Crypto Types, Enums, and Data Structures
##
## Part of the Alya Language package ecosystem (https://github.com/alya-lang).
## Defines standard algorithms, encoding formats, cipher modes, and cryptographic configuration.

## Enumeration of supported cryptographic hash algorithms.
##
## Identifies secure and legacy hashing algorithms:
## - `Sha256`: SHA-2 256-bit hash (FIPS 180-4 standard).
## - `Sha512`: SHA-2 512-bit hash (FIPS 180-4 standard).
## - `Sha384`: SHA-2 384-bit truncated hash.
## - `Sha224`: SHA-2 224-bit truncated hash.
## - `Sha512_256`: SHA-2 512/256 truncated hash.
## - `Sha512_224`: SHA-2 512/224 truncated hash.
## - `Sha1`: Legacy SHA-1 160-bit hash.
## - `Md5`: Legacy MD5 128-bit digest.
## - `Blake2s`: BLAKE2s high-performance 256-bit hash (RFC 7693).
## - `Sha3_224`: SHA-3 224-bit Keccak permutation (FIPS 202).
## - `Sha3_256`: SHA-3 256-bit Keccak permutation (FIPS 202).
## - `Sha3_384`: SHA-3 384-bit Keccak permutation (FIPS 202).
## - `Sha3_512`: SHA-3 512-bit Keccak permutation (FIPS 202).
pub enum HashAlgorithm
    Sha256 = 1,
    Sha512 = 2,
    Sha384 = 3,
    Sha224 = 4,
    Sha512_256 = 5,
    Sha512_224 = 6,
    Sha1 = 7,
    Md5 = 8,
    Blake2s = 9,
    Sha3_224 = 10,
    Sha3_256 = 11,
    Sha3_384 = 12,
    Sha3_512 = 13
end

## Enumeration of binary data text encoding formats.
##
## Identifies textual encoding representations:
## - `Hex`: Base-16 hexadecimal lowercase encoding.
## - `Base64`: Standard RFC 4648 Base64 encoding with padding.
## - `Base64Url`: URL-safe and filename-safe Base64 without padding.
## - `Base32`: Standard RFC 4648 Base32 uppercase encoding.
## - `Base58`: Bitcoin/IPFS Base58 alphabet encoding without ambiguous characters.
pub enum EncodingFormat
    Hex = 1,
    Base64 = 2,
    Base64Url = 3,
    Base32 = 4,
    Base58 = 5
end

## Enumeration of symmetric cipher algorithms.
##
## Identifies stream and block cipher suites:
## - `Aes128`: Advanced Encryption Standard with 128-bit key.
## - `Aes192`: Advanced Encryption Standard with 192-bit key.
## - `Aes256`: Advanced Encryption Standard with 256-bit key.
## - `ChaCha20`: RFC 8439 256-bit stream cipher.
## - `ChaCha20Poly1305`: RFC 8439 Authenticated Encryption with Associated Data (AEAD).
## - `Rc4`: Legacy stream cipher for compatibility testing.
pub enum CipherAlgorithm
    Aes128 = 1,
    Aes192 = 2,
    Aes256 = 3,
    ChaCha20 = 4,
    ChaCha20Poly1305 = 5,
    Rc4 = 6
end

## Enumeration of block cipher operation modes.
##
## Identifies block chaining and authentication modes:
## - `Cbc`: Cipher Block Chaining with PKCS#7 padding.
## - `Ctr`: Counter mode turning block cipher into stream cipher.
## - `Gcm`: Galois/Counter Mode authenticated encryption.
pub enum CipherMode
    Cbc = 1,
    Ctr = 2,
    Gcm = 3
end

## Enumeration of Message Authentication Code (MAC) algorithms.
##
## Identifies keyed integrity authentication primitives:
## - `HmacSha256`: HMAC keyed with SHA-256 (RFC 2104).
## - `HmacSha512`: HMAC keyed with SHA-512 (RFC 2104).
## - `HmacSha384`: HMAC keyed with SHA-384.
## - `HmacSha224`: HMAC keyed with SHA-224.
## - `HmacSha1`: HMAC keyed with SHA-1.
## - `HmacMd5`: HMAC keyed with MD5.
## - `Poly1305`: One-time 128-bit authenticator (RFC 8439).
pub enum MacAlgorithm
    HmacSha256 = 1,
    HmacSha512 = 2,
    HmacSha384 = 3,
    HmacSha224 = 4,
    HmacSha1 = 5,
    HmacMd5 = 6,
    Poly1305 = 7
end

## Configuration parameters for key derivation and cryptographic operations.
##
## ### Fields
## - `encoding`: Default encoding format used for text representation.
## - `iterations`: Number of key stretching iterations (e.g. PBKDF2).
## - `key_len`: Target derived key length in bytes.
pub struct CryptoConfig
    encoding: int,
    iterations: int,
    key_len: int
end

## Creates a default `CryptoConfig` instance.
##
## Default values: `encoding = EncodingFormat.Hex`, `iterations = 10000`, `key_len = 32`.
##
## ### Returns
## Initialized `CryptoConfig` instance.
pub function default_crypto_config() -> CryptoConfig
    return CryptoConfig(EncodingFormat.Hex, 10000, 32)
end
