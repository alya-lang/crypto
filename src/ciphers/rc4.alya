## RC4 (Rivest Cipher 4) Stream Cipher
##
## Part of the Alya Language package ecosystem (https://github.com/alya-lang).
## Symmetric stream cipher using Key-Scheduling (KSA) and Pseudo-Random Generation (PRGA).

import "../encodings/hex.alya"

## Processes data bytes through RC4 keystream XOR (symmetric encryption/decryption).
##
## ### Parameters
## - `key_bytes`: Key byte array.
## - `data_bytes`: Input byte array.
##
## ### Returns
## Processed byte array.
pub function rc4_process_bytes(key_bytes, data_bytes) -> array
    let klen = len(key_bytes)
    if klen == 0
        return data_bytes
    end

    # Key-Scheduling Algorithm (KSA)
    let s = []
    let i = 0
    while i < 256
        s.push(i)
        i += 1
    end

    let j = 0
    i = 0
    while i < 256
        j = (j + s[i] + key_bytes[i % klen]) % 256
        let temp = s[i]
        s[i] = s[j]
        s[j] = temp
        i += 1
    end

    # Pseudo-Random Generation Algorithm (PRGA)
    let out = []
    let dlen = len(data_bytes)
    let k = 0
    i = 0
    j = 0

    while k < dlen
        i = (i + 1) % 256
        j = (j + s[i]) % 256
        let temp = s[i]
        s[i] = s[j]
        s[j] = temp
        let keystream = s[(s[i] + s[j]) % 256]
        out.push(bit_xor(data_bytes[k], keystream))
        k += 1
    end

    return out
end

## Encrypts plaintext bytes using RC4. Alias for `rc4_process_bytes`.
pub function rc4_encrypt_bytes(key_bytes, plaintext_bytes) -> array
    return rc4_process_bytes(key_bytes, plaintext_bytes)
end

## Decrypts ciphertext bytes using RC4. Alias for `rc4_process_bytes`.
pub function rc4_decrypt_bytes(key_bytes, ciphertext_bytes) -> array
    return rc4_process_bytes(key_bytes, ciphertext_bytes)
end

## Encrypts a plaintext string using RC4, returning lowercase hex ciphertext.
##
## ### Parameters
## - `key_str`: Key string.
## - `plaintext_str`: Plaintext string.
##
## ### Returns
## Hexadecimal ciphertext string.
pub function rc4_encrypt(key_str: str, plaintext_str: str) -> str
    let k_bytes = str_to_bytes(key_str)
    let p_bytes = str_to_bytes(plaintext_str)
    let ct = rc4_process_bytes(k_bytes, p_bytes)
    return bytes_to_hex(ct)
end

## Decrypts a hexadecimal RC4 ciphertext string back to plaintext.
##
## ### Parameters
## - `key_str`: Key string.
## - `ciphertext_hex`: Hexadecimal ciphertext string.
##
## ### Returns
## Decrypted plaintext string.
pub function rc4_decrypt(key_str: str, ciphertext_hex: str) -> str
    let k_bytes = str_to_bytes(key_str)
    let c_bytes = hex_to_bytes(ciphertext_hex)
    let dec_bytes = rc4_process_bytes(k_bytes, c_bytes)
    return bytes_to_str(dec_bytes)
end
