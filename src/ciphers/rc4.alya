# RC4 (Rivest Cipher 4) Stream Cipher
# Part of the Alya Language package ecosystem (https://github.com/alya-lang)

import "../encodings/hex.alya"

function rc4_process_bytes(key_bytes, data_bytes)
    let klen = len(key_bytes)
    if klen == 0
        return data_bytes
    end

    # Key-Scheduling Algorithm (KSA)
    let s = []
    let i = 0
    while i < 256
        s.push(i)
        i += 1
    end

    let j = 0
    i = 0
    while i < 256
        j = (j + s[i] + key_bytes[i % klen]) % 256
        let temp = s[i]
        s[i] = s[j]
        s[j] = temp
        i += 1
    end

    # Pseudo-Random Generation Algorithm (PRGA)
    let out = []
    let dlen = len(data_bytes)
    let k = 0
    i = 0
    j = 0

    while k < dlen
        i = (i + 1) % 256
        j = (j + s[i]) % 256
        let temp = s[i]
        s[i] = s[j]
        s[j] = temp
        let keystream = s[(s[i] + s[j]) % 256]
        out.push(bit_xor(data_bytes[k], keystream))
        k += 1
    end

    return out
end

function rc4_encrypt_bytes(key_bytes, plaintext_bytes)
    return rc4_process_bytes(key_bytes, plaintext_bytes)
end

function rc4_decrypt_bytes(key_bytes, ciphertext_bytes)
    return rc4_process_bytes(key_bytes, ciphertext_bytes)
end

function rc4_encrypt(key_str, plaintext_str)
    let k_bytes = str_to_bytes(key_str)
    let p_bytes = str_to_bytes(plaintext_str)
    let ct = rc4_process_bytes(k_bytes, p_bytes)
    return bytes_to_hex(ct)
end

function rc4_decrypt(key_str, ciphertext_hex)
    let k_bytes = str_to_bytes(key_str)
    let c_bytes = hex_to_bytes(ciphertext_hex)
    let dec_bytes = rc4_process_bytes(k_bytes, c_bytes)
    return bytes_to_str(dec_bytes)
end
