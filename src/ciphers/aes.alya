## Returns the AES round constant (Rcon) table.
##
## # Returns
## Array of 11 round constants.
pub function get_aes_rcon()
    return [0, 1, 2, 4, 8, 16, 32, 64, 128, 27, 54]
end

## Multiplies an 8-bit value by 2 in GF(2^8).
##
## # Arguments
## * `a` - 8-bit input value.
##
## # Returns
## Result of multiplication modulo x^8 + x^4 + x^3 + x + 1.
pub function _aes_xtime(a)
    let shifted = bit_shl(a, 1)
    if bit_and(a, 128) != 0
        return bit_and(bit_xor(shifted, 27), 255)
    end
    return bit_and(shifted, 255)
end

## Multiplies two 8-bit elements in GF(2^8).
##
## # Arguments
## * `a` - First element.
## * `b` - Second element.
##
## # Returns
## Product in GF(2^8).
pub function _aes_gf_mul(a, b)
    let res = 0
    let temp_a = a
    let temp_b = b
    while temp_b > 0
        if bit_and(temp_b, 1) != 0
            res = bit_xor(res, temp_a)
        end
        temp_a = _aes_xtime(temp_a)
        temp_b = bit_shr(temp_b, 1)
    end
    return res
end

## Expands a 128-bit or 256-bit AES cipher key into round keys.
##
## # Arguments
## * `key_bytes` - 16-byte (AES-128) or 32-byte (AES-256) key array.
##
## # Returns
## Two-element array: `[expanded_key_words, round_count]`.
pub function aes_key_expansion(key_bytes)
    let sbox = get_aes_sbox()
    let rcon = get_aes_rcon()
    let klen = len(key_bytes)
    let nk = bit_shr(klen, 2)
    let nr = 10
    if nk == 6
        nr = 12
    end
    if nk == 8
        nr = 14
    end

    let total_words = 4 * (nr + 1)
    let w = []

    let i = 0
    while i < nk
        w.push(key_bytes[4 * i])
        w.push(key_bytes[4 * i + 1])
        w.push(key_bytes[4 * i + 2])
        w.push(key_bytes[4 * i + 3])
        i += 1
    end

    while i < total_words
        let t0 = w[4 * (i - 1)]
        let t1 = w[4 * (i - 1) + 1]
        let t2 = w[4 * (i - 1) + 2]
        let t3 = w[4 * (i - 1) + 3]

        if i % nk == 0
            let temp = t0
            t0 = t1
            t1 = t2
            t2 = t3
            t3 = temp

            t0 = sbox[t0]
            t1 = sbox[t1]
            t2 = sbox[t2]
            t3 = sbox[t3]

            let r_idx = i / nk
            t0 = bit_xor(t0, rcon[r_idx])
        end

        if nk > 6 and i % nk == 4
            t0 = sbox[t0]
            t1 = sbox[t1]
            t2 = sbox[t2]
            t3 = sbox[t3]
        end

        let p0 = w[4 * (i - nk)]
        let p1 = w[4 * (i - nk) + 1]
        let p2 = w[4 * (i - nk) + 2]
        let p3 = w[4 * (i - nk) + 3]

        w.push(bit_xor(p0, t0))
        w.push(bit_xor(p1, t1))
        w.push(bit_xor(p2, t2))
        w.push(bit_xor(p3, t3))

        i += 1
    end

    return [w, nr]
end

## Encrypts a single 16-byte block using AES.
##
## # Arguments
## * `exp_keys` - Expanded round key word array.
## * `nr` - Number of rounds (10 for AES-128, 14 for AES-256).
## * `block16` - 16-byte plaintext input block.
##
## # Returns
## 16-byte encrypted ciphertext block.
pub function aes_encrypt_block(exp_keys, nr, block16)
    let sbox = get_aes_sbox()
    let s = []
    let i = 0
    while i < 16
        s.push(block16[i])
        i += 1
    end

    i = 0
    while i < 16
        s[i] = bit_xor(s[i], exp_keys[i])
        i += 1
    end

    let round = 1
    while round < nr
        i = 0
        while i < 16
            s[i] = sbox[s[i]]
            i += 1
        end

        let temp = s[1]
        s[1] = s[5]
        s[5] = s[9]
        s[9] = s[13]
        s[13] = temp

        temp = s[2]
        s[2] = s[10]
        s[10] = temp
        temp = s[6]
        s[6] = s[14]
        s[14] = temp

        temp = s[15]
        s[15] = s[11]
        s[11] = s[7]
        s[7] = s[3]
        s[3] = temp

        let col = 0
        while col < 4
            let c = col * 4
            let a0 = s[c]
            let a1 = s[c + 1]
            let a2 = s[c + 2]
            let a3 = s[c + 3]

            s[c]     = bit_xor(bit_xor(_aes_xtime(a0), bit_xor(_aes_xtime(a1), a1)), bit_xor(a2, a3))
            s[c + 1] = bit_xor(bit_xor(a0, _aes_xtime(a1)), bit_xor(bit_xor(_aes_xtime(a2), a2), a3))
            s[c + 2] = bit_xor(bit_xor(a0, a1), bit_xor(_aes_xtime(a2), bit_xor(_aes_xtime(a3), a3)))
            s[c + 3] = bit_xor(bit_xor(bit_xor(_aes_xtime(a0), a0), a1), bit_xor(a2, _aes_xtime(a3)))

            col += 1
        end

        let r_offset = round * 16
        i = 0
        while i < 16
            s[i] = bit_xor(s[i], exp_keys[r_offset + i])
            i += 1
        end

        round += 1
    end

    # Final Round (without MixColumns)
    i = 0
    while i < 16
        s[i] = sbox[s[i]]
        i += 1
    end

    let temp = s[1]
    s[1] = s[5]
    s[5] = s[9]
    s[9] = s[13]
    s[13] = temp

    temp = s[2]
    s[2] = s[10]
    s[10] = temp
    temp = s[6]
    s[6] = s[14]
    s[14] = temp

    temp = s[15]
    s[15] = s[11]
    s[11] = s[7]
    s[7] = s[3]
    s[3] = temp

    let r_offset = nr * 16
    i = 0
    while i < 16
        s[i] = bit_xor(s[i], exp_keys[r_offset + i])
        i += 1
    end

    return s
end

## Decrypts a single 16-byte block using AES.
##
## # Arguments
## * `exp_keys` - Expanded round key word array.
## * `nr` - Number of rounds (10 for AES-128, 14 for AES-256).
## * `block16` - 16-byte ciphertext input block.
##
## # Returns
## 16-byte decrypted plaintext block.
pub function aes_decrypt_block(exp_keys, nr, block16)
    let rsbox = get_aes_rsbox()
    let s = []
    let i = 0
    while i < 16
        s.push(block16[i])
        i += 1
    end

    let r_offset = nr * 16
    i = 0
    while i < 16
        s[i] = bit_xor(s[i], exp_keys[r_offset + i])
        i += 1
    end

    let round = nr - 1
    while round > 0
        let temp = s[13]
        s[13] = s[9]
        s[9] = s[5]
        s[5] = s[1]
        s[1] = temp

        temp = s[2]
        s[2] = s[10]
        s[10] = temp
        temp = s[6]
        s[6] = s[14]
        s[14] = temp

        temp = s[3]
        s[3] = s[7]
        s[7] = s[11]
        s[11] = s[15]
        s[15] = temp

        i = 0
        while i < 16
            s[i] = rsbox[s[i]]
            i += 1
        end

        r_offset = round * 16
        i = 0
        while i < 16
            s[i] = bit_xor(s[i], exp_keys[r_offset + i])
            i += 1
        end

        let col = 0
        while col < 4
            let c = col * 4
            let s0 = s[c]
            let s1 = s[c + 1]
            let s2 = s[c + 2]
            let s3 = s[c + 3]

            s[c]     = bit_xor(bit_xor(_aes_gf_mul(14, s0), _aes_gf_mul(11, s1)), bit_xor(_aes_gf_mul(13, s2), _aes_gf_mul(9, s3)))
            s[c + 1] = bit_xor(bit_xor(_aes_gf_mul(9, s0), _aes_gf_mul(14, s1)), bit_xor(_aes_gf_mul(11, s2), _aes_gf_mul(13, s3)))
            s[c + 2] = bit_xor(bit_xor(_aes_gf_mul(13, s0), _aes_gf_mul(9, s1)), bit_xor(_aes_gf_mul(14, s2), _aes_gf_mul(11, s3)))
            s[c + 3] = bit_xor(bit_xor(_aes_gf_mul(11, s0), _aes_gf_mul(13, s1)), bit_xor(_aes_gf_mul(9, s2), _aes_gf_mul(14, s3)))

            col += 1
        end

        round -= 1
    end

    let temp = s[13]
    s[13] = s[9]
    s[9] = s[5]
    s[5] = s[1]
    s[1] = temp

    temp = s[2]
    s[2] = s[10]
    s[10] = temp
    temp = s[6]
    s[6] = s[14]
    s[14] = temp

    temp = s[3]
    s[3] = s[7]
    s[7] = s[11]
    s[11] = s[15]
    s[15] = temp

    i = 0
    while i < 16
        s[i] = rsbox[s[i]]
        i += 1
    end

    i = 0
    while i < 16
        s[i] = bit_xor(s[i], exp_keys[i])
        i += 1
    end

    return s
end

## Applies PKCS#7 padding to a byte array to align to block size.
##
## # Arguments
## * `data_bytes` - Input unpadded byte array.
## * `block_size` - Cipher block size in bytes (default: 16).
##
## # Returns
## Padded byte array.
pub function pkcs7_pad(data_bytes, block_size = 16)
    let dlen = len(data_bytes)
    let pad_len = block_size - (dlen % block_size)
    let out_padded = []
    let i = 0
    while i < dlen
        out_padded.push(data_bytes[i])
        i += 1
    end
    i = 0
    while i < pad_len
        out_padded.push(pad_len)
        i += 1
    end
    return out_padded
end

## Removes PKCS#7 padding from a byte array.
##
## # Arguments
## * `data_bytes` - Padded byte array.
##
## # Returns
## Unpadded byte array, or original array if padding is invalid.
pub function pkcs7_unpad(data_bytes)
    let dlen = len(data_bytes)
    if dlen == 0
        return []
    end
    let pad_len = data_bytes[dlen - 1]
    if pad_len == 0 or pad_len > 16 or pad_len > dlen
        return data_bytes
    end
    let i = dlen - pad_len
    while i < dlen
        if data_bytes[i] != pad_len
            return data_bytes
        end
        i += 1
    end
    let out_unpadded = []
    i = 0
    let target_len = dlen - pad_len
    while i < target_len
        out_unpadded.push(data_bytes[i])
        i += 1
    end
    return out_unpadded
end

## Encrypts plaintext bytes in AES Cipher Block Chaining (CBC) mode with PKCS#7 padding.
##
## # Arguments
## * `key_bytes` - 16-byte or 32-byte secret key array.
## * `iv_bytes` - 16-byte initialization vector array.
## * `plaintext_bytes` - Input plaintext byte array.
##
## # Returns
## Padded ciphertext byte array.
pub function aes_cbc_encrypt_bytes(key_bytes, iv_bytes, plaintext_bytes)
    let exp_info = aes_key_expansion(key_bytes)
    let w = exp_info[0]
    let nr = exp_info[1]

    let padded = pkcs7_pad(plaintext_bytes, 16)
    let plen = len(padded)
    let out = []

    let prev = []
    let i = 0
    while i < 16
        prev.push(iv_bytes[i])
        i += 1
    end

    let offset = 0
    while offset < plen
        let block_in = []
        i = 0
        while i < 16
            block_in.push(bit_xor(padded[offset + i], prev[i]))
            i += 1
        end

        let ct_block = aes_encrypt_block(w, nr, block_in)
        i = 0
        while i < 16
            out.push(ct_block[i])
            prev[i] = ct_block[i]
            i += 1
        end

        offset += 16
    end

    return out
end

## Decrypts ciphertext bytes in AES CBC mode and strips PKCS#7 padding.
##
## # Arguments
## * `key_bytes` - 16-byte or 32-byte secret key array.
## * `iv_bytes` - 16-byte initialization vector array.
## * `ciphertext_bytes` - Padded ciphertext byte array.
##
## # Returns
## Unpadded plaintext byte array.
pub function aes_cbc_decrypt_bytes(key_bytes, iv_bytes, ciphertext_bytes)
    let exp_info = aes_key_expansion(key_bytes)
    let w = exp_info[0]
    let nr = exp_info[1]

    let clen = len(ciphertext_bytes)
    let out_padded = []

    let prev = []
    let i = 0
    while i < 16
        prev.push(iv_bytes[i])
        i += 1
    end

    let offset = 0
    while offset < clen
        let ct_block = []
        i = 0
        while i < 16
            ct_block.push(ciphertext_bytes[offset + i])
            i += 1
        end

        let pt_block = aes_decrypt_block(w, nr, ct_block)
        i = 0
        while i < 16
            out_padded.push(bit_xor(pt_block[i], prev[i]))
            prev[i] = ct_block[i]
            i += 1
        end

        offset += 16
    end

    return pkcs7_unpad(out_padded)
end

## Encrypts a plaintext string in AES CBC mode.
##
## # Arguments
## * `key_bytes` - 16-byte or 32-byte secret key array.
## * `iv_bytes` - 16-byte initialization vector array.
## * `plaintext_str` - Plaintext string.
##
## # Returns
## Hex-encoded ciphertext string.
pub function aes_cbc_encrypt(key_bytes, iv_bytes, plaintext_str)
    let p_bytes = str_to_bytes(plaintext_str)
    let c_bytes = aes_cbc_encrypt_bytes(key_bytes, iv_bytes, p_bytes)
    return bytes_to_hex(c_bytes)
end

## Decrypts a hex-encoded ciphertext string in AES CBC mode.
##
## # Arguments
## * `key_bytes` - 16-byte or 32-byte secret key array.
## * `iv_bytes` - 16-byte initialization vector array.
## * `ciphertext_hex` - Hex-encoded ciphertext string.
##
## # Returns
## Decrypted plaintext string.
pub function aes_cbc_decrypt(key_bytes, iv_bytes, ciphertext_hex)
    let c_bytes = hex_to_bytes(ciphertext_hex)
    let d_bytes = aes_cbc_decrypt_bytes(key_bytes, iv_bytes, c_bytes)
    return bytes_to_str(d_bytes)
end

## Increments a 16-byte big-endian counter in-place.
##
## # Arguments
## * `ctr16` - 16-byte counter array.
pub function _aes_inc_counter(ctr16)
    let i = 15
    while i >= 0
        ctr16[i] = (ctr16[i] + 1) % 256
        if ctr16[i] != 0
            break
        end
        i -= 1
    end
end

## Processes data using AES Counter (CTR) mode stream cipher.
##
## # Arguments
## * `key_bytes` - 16-byte or 32-byte secret key array.
## * `iv_bytes` - 16-byte initial counter block.
## * `data_bytes` - Input byte array to encrypt or decrypt.
##
## # Returns
## Processed byte array.
pub function aes_ctr_process_bytes(key_bytes, iv_bytes, data_bytes)
    let exp_info = aes_key_expansion(key_bytes)
    let w = exp_info[0]
    let nr = exp_info[1]

    let dlen = len(data_bytes)
    let out = []

    let ctr = []
    let i = 0
    while i < 16
        ctr.push(iv_bytes[i])
        i += 1
    end

    let offset = 0
    while offset < dlen
        let keystream = aes_encrypt_block(w, nr, ctr)
        _aes_inc_counter(ctr)

        let chunk = 16
        if offset + chunk > dlen
            chunk = dlen - offset
        end

        i = 0
        while i < chunk
            out.push(bit_xor(data_bytes[offset + i], keystream[i]))
            i += 1
        end

        offset += chunk
    end

    return out
end

## Encrypts plaintext bytes in AES CTR mode.
##
## # Arguments
## * `key_bytes` - 16-byte or 32-byte secret key array.
## * `iv_bytes` - 16-byte initial counter block.
## * `plaintext_bytes` - Plaintext byte array.
##
## # Returns
## Ciphertext byte array.
pub function aes_ctr_encrypt_bytes(key_bytes, iv_bytes, plaintext_bytes)
    return aes_ctr_process_bytes(key_bytes, iv_bytes, plaintext_bytes)
end

## Decrypts ciphertext bytes in AES CTR mode.
##
## # Arguments
## * `key_bytes` - 16-byte or 32-byte secret key array.
## * `iv_bytes` - 16-byte initial counter block.
## * `ciphertext_bytes` - Ciphertext byte array.
##
## # Returns
## Decrypted plaintext byte array.
pub function aes_ctr_decrypt_bytes(key_bytes, iv_bytes, ciphertext_bytes)
    return aes_ctr_process_bytes(key_bytes, iv_bytes, ciphertext_bytes)
end

## Encrypts a plaintext string in AES CTR mode.
##
## # Arguments
## * `key_bytes` - 16-byte or 32-byte secret key array.
## * `iv_bytes` - 16-byte initial counter block.
## * `plaintext_str` - Plaintext string.
##
## # Returns
## Hex-encoded ciphertext string.
pub function aes_ctr_encrypt(key_bytes, iv_bytes, plaintext_str)
    let p_bytes = str_to_bytes(plaintext_str)
    let c_bytes = aes_ctr_process_bytes(key_bytes, iv_bytes, p_bytes)
    return bytes_to_hex(c_bytes)
end

## Decrypts a hex-encoded ciphertext string in AES CTR mode.
##
## # Arguments
## * `key_bytes` - 16-byte or 32-byte secret key array.
## * `iv_bytes` - 16-byte initial counter block.
## * `ciphertext_hex` - Hex-encoded ciphertext string.
##
## # Returns
## Decrypted plaintext string.
pub function aes_ctr_decrypt(key_bytes, iv_bytes, ciphertext_hex)
    let c_bytes = hex_to_bytes(ciphertext_hex)
    let d_bytes = aes_ctr_process_bytes(key_bytes, iv_bytes, c_bytes)
    return bytes_to_str(d_bytes)
end
