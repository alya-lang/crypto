## Password Hashing & Verification (PBKDF2-HMAC-SHA256)
##
## Part of the Alya Language package ecosystem (https://github.com/alya-lang).
## Secure salt generation, key stretching, and constant-time password verification.

import "pbkdf2.alya"
import "../random/entropy.alya"
import "../core/security.alya"

## Hashes a password string with a cryptographically secure random salt using PBKDF2-HMAC-SHA256.
##
## Output record format: `$alya-kdf$v=1$i=<iters>$<salt_hex>$<hash_hex>`
##
## ### Parameters
## - `password_str`: Plaintext password string.
## - `iterations`: Number of PBKDF2 iterations (default 10,000).
##
## ### Returns
## Self-contained encoded hash record string.
pub function password_hash(password_str: str, iterations: int = 10000) -> str
    let salt_hex = random_hex(16)
    let hash_hex = pbkdf2_hmac_sha256(password_str, salt_hex, iterations, 32)
    return "$alya-kdf$v=1$i=" + str(iterations) + "$" + salt_hex + "$" + hash_hex
end

## Verifies a plaintext password against an `$alya-kdf` formatted hash record in constant time.
##
## ### Parameters
## - `password_str`: Plaintext password string to test.
## - `hash_record_str`: Stored password record string.
##
## ### Returns
## `true` if password matches record, `false` otherwise.
pub function password_verify(password_str: str, hash_record_str: str) -> bool
    let rlen = len(hash_record_str)
    if rlen < 20
        return 0
    end

    # Split by '$'
    let parts = []
    let curr = ""
    let i = 0
    while i < rlen
        let ch = char_at(hash_record_str, i)
        if ch == "$"
            if len(curr) > 0
                parts.push(curr)
                curr = ""
            end
        else
            curr = curr + ch
        end
        i += 1
    end
    if len(curr) > 0
        parts.push(curr)
    end

    # Expected format: ["alya-kdf", "v=1", "i=10000", "<salt_hex>", "<hash_hex>"]
    if len(parts) < 5
        return 0
    end
    if parts[0] != "alya-kdf"
        return 0
    end

    # Parse iterations from "i=XXXX"
    let iter_str = parts[2]
    if len(iter_str) <= 2
        return 0
    end
    let iters = int(substring(iter_str, 2, len(iter_str) - 2))

    let salt_hex = parts[3]
    let expected_hash_hex = parts[4]

    let computed_hash_hex = pbkdf2_hmac_sha256(password_str, salt_hex, iters, 32)
    return constant_time_eq(computed_hash_hex, expected_hash_hex)
end
