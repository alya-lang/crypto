# Password Hashing and Verification (PBKDF2-HMAC-SHA256 based)
# Part of the Alya Language package ecosystem (https://github.com/alya-lang)

import "pbkdf2.alya"
import "../random/entropy.alya"
import "../core/security.alya"
import "../encodings/hex.alya"

# Formats password hash as: $alya-kdf$v=1$i=<iters>$<salt_hex>$<hash_hex>
function password_hash(password_str, iterations = 10000)
    let salt_hex = random_hex(16)
    let hash_hex = pbkdf2_hmac_sha256(password_str, salt_hex, iterations, 32)
    return "$alya-kdf$v=1$i=" + str(iterations) + "$" + salt_hex + "$" + hash_hex
end

function password_verify(password_str, hash_record_str)
    let rlen = len(hash_record_str)
    if rlen < 20
        return 0
    end

    # Split by '$'
    let parts = []
    let curr = ""
    let i = 0
    while i < rlen
        let ch = char_at(hash_record_str, i)
        if ch == "$"
            if len(curr) > 0
                parts.push(curr)
                curr = ""
            end
        else
            curr = curr + ch
        end
        i += 1
    end
    if len(curr) > 0
        parts.push(curr)
    end

    # Expected format: ["alya-kdf", "v=1", "i=10000", "<salt_hex>", "<hash_hex>"]
    if len(parts) < 5
        return 0
    end
    if parts[0] != "alya-kdf"
        return 0
    end

    # Parse iterations from "i=XXXX"
    let iter_str = parts[2]
    if len(iter_str) <= 2
        return 0
    end
    let iters = int(substring(iter_str, 2, len(iter_str) - 2))

    let salt_hex = parts[3]
    let expected_hash_hex = parts[4]

    let computed_hash_hex = pbkdf2_hmac_sha256(password_str, salt_hex, iters, 32)
    return constant_time_eq(computed_hash_hex, expected_hash_hex)
end
