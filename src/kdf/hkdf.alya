## HMAC-based Extract-and-Expand Key Derivation Function (HKDF - RFC 5869)
##
## Part of the Alya Language package ecosystem (https://github.com/alya-lang).
## Standard two-step key derivation function based on HMAC.

import "../mac/hmac.alya"
import "../encodings/hex.alya"

## Extracts a pseudorandom key (PRK) from input keying material (IKM) and optional salt.
##
## ### Parameters
## - `salt_bytes`: Optional salt byte array.
## - `ikm_bytes`: Input keying material byte array.
## - `hash_algo`: Underlying hash algorithm name (`"sha256"`, `"sha384"`, or `"sha512"`).
##
## ### Returns
## Pseudorandom key (PRK) byte array.
pub function hkdf_extract_bytes(salt_bytes, ikm_bytes, hash_algo: str = "sha256") -> array
    let s = []
    let slen = len(salt_bytes)
    if slen == 0
        let hash_len = 32
        if hash_algo == "sha512"
            hash_len = 64
        elif hash_algo == "sha384"
            hash_len = 48
        end
        let z = 0
        while z < hash_len
            s.push(0)
            z += 1
        end
    else
        let i = 0
        while i < slen
            s.push(salt_bytes[i])
            i += 1
        end
    end

    if hash_algo == "sha512"
        return hmac_sha512_bytes(s, ikm_bytes)
    elif hash_algo == "sha384"
        return hmac_sha384_bytes(s, ikm_bytes)
    end
    return hmac_sha256_bytes(s, ikm_bytes)
end

## Expands a pseudorandom key (PRK) to output keying material (OKM) of desired length.
##
## ### Parameters
## - `prk_bytes`: Pseudorandom key byte array.
## - `info_bytes`: Optional context and application specific info byte array.
## - `length`: Desired output keying material length in bytes.
## - `hash_algo`: Underlying hash algorithm name.
##
## ### Returns
## Output keying material (OKM) byte array of length `length`.
pub function hkdf_expand_bytes(prk_bytes, info_bytes, length: int, hash_algo: str = "sha256") -> array
    let hash_len = 32
    if hash_algo == "sha512"
        hash_len = 64
    elif hash_algo == "sha384"
        hash_len = 48
    end

    let n = (length + hash_len - 1) / hash_len
    let okm = []
    let t = []
    let i = 1
    let ilen = len(info_bytes)

    while i <= n
        let step_data = []
        let ti = 0
        let tlen = len(t)
        while ti < tlen
            step_data.push(t[ti])
            ti += 1
        end
        let ii = 0
        while ii < ilen
            step_data.push(info_bytes[ii])
            ii += 1
        end
        step_data.push(i)

        if hash_algo == "sha512"
            t = hmac_sha512_bytes(prk_bytes, step_data)
        elif hash_algo == "sha384"
            t = hmac_sha384_bytes(prk_bytes, step_data)
        else
            t = hmac_sha256_bytes(prk_bytes, step_data)
        end

        let tj = 0
        while tj < hash_len and len(okm) < length
            okm.push(t[tj])
            tj += 1
        end
        i += 1
    end

    return okm
end

## Full HKDF extract-and-expand pipeline returning raw byte integers.
##
## ### Parameters
## - `salt_bytes`: Salt byte array.
## - `ikm_bytes`: Input keying material byte array.
## - `info_bytes`: Context info byte array.
## - `length`: Output key length in bytes.
## - `hash_algo`: Underlying hash algorithm name.
##
## ### Returns
## Output keying material (OKM) byte array.
pub function hkdf_bytes(salt_bytes, ikm_bytes, info_bytes, length: int, hash_algo: str = "sha256") -> array
    let prk = hkdf_extract_bytes(salt_bytes, ikm_bytes, hash_algo)
    return hkdf_expand_bytes(prk, info_bytes, length, hash_algo)
end

## Full HKDF extract-and-expand from string inputs, returning lowercase hex.
##
## ### Parameters
## - `salt_str`: Salt string.
## - `ikm_str`: Input keying material string.
## - `info_str`: Context info string.
## - `length`: Output key length in bytes.
## - `hash_algo`: Underlying hash algorithm name.
##
## ### Returns
## Lowercase hex representation of derived key material.
pub function hkdf(salt_str: str, ikm_str: str, info_str: str, length: int, hash_algo: str = "sha256") -> str
    let s_bytes = str_to_bytes(salt_str)
    let k_bytes = str_to_bytes(ikm_str)
    let i_bytes = str_to_bytes(info_str)
    let okm = hkdf_bytes(s_bytes, k_bytes, i_bytes, length, hash_algo)
    return bytes_to_hex(okm)
end

## Full HKDF extract-and-expand from hex inputs, returning lowercase hex.
##
## ### Parameters
## - `salt_hex`: Hexadecimal salt string.
## - `ikm_hex`: Hexadecimal IKM string.
## - `info_hex`: Hexadecimal info string.
## - `length`: Output key length in bytes.
## - `hash_algo`: Underlying hash algorithm name.
##
## ### Returns
## Lowercase hex representation of derived key material.
pub function hkdf_hex(salt_hex: str, ikm_hex: str, info_hex: str, length: int, hash_algo: str = "sha256") -> str
    let s_bytes = hex_to_bytes(salt_hex)
    let k_bytes = hex_to_bytes(ikm_hex)
    let i_bytes = hex_to_bytes(info_hex)
    let okm = hkdf_bytes(s_bytes, k_bytes, i_bytes, length, hash_algo)
    return bytes_to_hex(okm)
end
