## Base64URL Encoding & Decoding (RFC 7515 / RFC 4648 §5)
##
## Part of the Alya Language package ecosystem (https://github.com/alya-lang).
## URL-safe and filename-safe Base64 encoding without padding.

## Encodes a byte array into an unpadded Base64URL string.
##
## ### Parameters
## - `bytes`: Byte array integers `[0..255]`.
##
## ### Returns
## Encoded Base64URL string.
pub function base64url_encode_bytes(bytes) -> str
    let chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_"
    let blen = len(bytes)
    let res = ""
    let i = 0
    let b0, b1, b2 = 0
    let has_b1, has_b2 = 0
    let idx0, idx1, idx2, idx3 = 0

    while i < blen
        b0 = bytes[i]
        b1 = 0
        b2 = 0
        has_b1 = 0
        has_b2 = 0

        if i + 1 < blen
            b1 = bytes[i + 1]
            has_b1 = 1
        end
        if i + 2 < blen
            b2 = bytes[i + 2]
            has_b2 = 1
        end

        idx0 = bit_and(bit_shr(b0, 2), 63)
        idx1 = bit_and(bit_or(bit_shl(bit_and(b0, 3), 4), bit_shr(b1, 4)), 63)

        res = res + char_at(chars, idx0) + char_at(chars, idx1)

        if has_b1 == 1
            idx2 = bit_and(bit_or(bit_shl(bit_and(b1, 15), 2), bit_shr(b2, 6)), 63)
            res = res + char_at(chars, idx2)
        end

        if has_b2 == 1
            idx3 = bit_and(b2, 63)
            res = res + char_at(chars, idx3)
        end

        i += 3
    end

    return res
end

## Encodes an Alya string into unpadded Base64URL representation.
##
## ### Parameters
## - `s`: Input string.
##
## ### Returns
## Encoded Base64URL string.
pub function base64url_encode(s: str) -> str
    let slen = len(s)
    let bytes = []
    let i = 0
    while i < slen
        bytes.push(ord(char_at(s, i)))
        i += 1
    end
    return base64url_encode_bytes(bytes)
end

## Resolves numeric index of a Base64URL character.
pub function _b64url_val(ch) -> int
    let c = ord(ch)
    when c
        is 65..90 then return c - 65
        is 97..122 then return c - 71
        is 48..57 then return c + 4
        is 45, 43 then return 62
        is 95, 47 then return 63
        else return 0
    end
end

## Decodes a Base64URL string into raw byte integers.
##
## ### Parameters
## - `s`: Base64URL encoded string.
##
## ### Returns
## Array of byte integers.
pub function base64url_decode_bytes(s: str) -> array
    let slen = len(s)
    if slen == 0
        return []
    end

    let bytes = []
    let i = 0
    let v0, v1, v2, v3 = 0
    let b0, b1, b2 = 0
    let rem = 0

    while i + 3 < slen
        v0 = _b64url_val(char_at(s, i))
        v1 = _b64url_val(char_at(s, i + 1))
        v2 = _b64url_val(char_at(s, i + 2))
        v3 = _b64url_val(char_at(s, i + 3))

        b0 = bit_or(bit_shl(v0, 2), bit_and(bit_shr(v1, 4), 3))
        b1 = bit_and(bit_or(bit_shl(bit_and(v1, 15), 4), bit_shr(v2, 2)), 255)
        b2 = bit_and(bit_or(bit_shl(bit_and(v2, 3), 6), v3), 255)

        bytes.push(b0)
        bytes.push(b1)
        bytes.push(b2)
        i += 4
    end

    rem = slen - i
    if rem == 2
        v0 = _b64url_val(char_at(s, i))
        v1 = _b64url_val(char_at(s, i + 1))
        b0 = bit_or(bit_shl(v0, 2), bit_and(bit_shr(v1, 4), 3))
        bytes.push(b0)
    elif rem == 3
        v0 = _b64url_val(char_at(s, i))
        v1 = _b64url_val(char_at(s, i + 1))
        v2 = _b64url_val(char_at(s, i + 2))
        b0 = bit_or(bit_shl(v0, 2), bit_and(bit_shr(v1, 4), 3))
        b1 = bit_and(bit_or(bit_shl(bit_and(v1, 15), 4), bit_shr(v2, 2)), 255)
        bytes.push(b0)
        bytes.push(b1)
    end

    return bytes
end

## Decodes a Base64URL string back into an Alya string.
##
## ### Parameters
## - `s`: Base64URL encoded string.
##
## ### Returns
## Decoded UTF-8 string.
pub function base64url_decode(s: str) -> str
    let bytes = base64url_decode_bytes(s)
    let blen = len(bytes)
    let res = ""
    let i = 0
    while i < blen
        res = res + chr(bytes[i])
        i += 1
    end
    return res
end
