## Base32 Encoding & Decoding (RFC 4648)
##
## Part of the Alya Language package ecosystem (https://github.com/alya-lang).
## Standard Base32 text encoding and decoding routines.

## Encodes a byte array into a Base32 string with optional padding.
##
## ### Parameters
## - `bytes`: Byte array integers `[0..255]`.
## - `pad`: `1` to append `'='` padding characters, `0` for raw unpadded output.
##
## ### Returns
## Encoded Base32 string.
pub function base32_encode_bytes(bytes, pad: int = 1) -> str
    let b32_chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZ234567"
    let blen = len(bytes)
    let res = ""
    let i = 0
    while i < blen
        let b0 = bytes[i]
        let b1 = 0
        let b2 = 0
        let b3 = 0
        let b4 = 0
        let count = 1

        if i + 1 < blen
            b1 = bytes[i + 1]
            count = 2
        end
        if i + 2 < blen
            b2 = bytes[i + 2]
            count = 3
        end
        if i + 3 < blen
            b3 = bytes[i + 3]
            count = 4
        end
        if i + 4 < blen
            b4 = bytes[i + 4]
            count = 5
        end

        let c0 = bit_and(bit_shr(b0, 3), 31)
        let c1 = bit_and(bit_or(bit_shl(bit_and(b0, 7), 2), bit_shr(b1, 6)), 31)
        let c2 = bit_and(bit_shr(b1, 1), 31)
        let c3 = bit_and(bit_or(bit_shl(bit_and(b1, 1), 4), bit_shr(b2, 4)), 31)
        let c4 = bit_and(bit_or(bit_shl(bit_and(b2, 15), 1), bit_shr(b3, 7)), 31)
        let c5 = bit_and(bit_shr(b3, 2), 31)
        let c6 = bit_and(bit_or(bit_shl(bit_and(b3, 3), 3), bit_shr(b4, 5)), 31)
        let c7 = bit_and(b4, 31)

        res = res + char_at(b32_chars, c0) + char_at(b32_chars, c1)

        when count
            is 1 then
                if pad == 1
                    res = res + "======"
                end
            is 2 then
                res = res + char_at(b32_chars, c2) + char_at(b32_chars, c3)
                if pad == 1
                    res = res + "===="
                end
            is 3 then
                res = res + char_at(b32_chars, c2) + char_at(b32_chars, c3) + char_at(b32_chars, c4)
                if pad == 1
                    res = res + "==="
                end
            is 4 then
                res = res + char_at(b32_chars, c2) + char_at(b32_chars, c3) + char_at(b32_chars, c4) + char_at(b32_chars, c5) + char_at(b32_chars, c6)
                if pad == 1
                    res = res + "="
                end
            else
                res = res + char_at(b32_chars, c2) + char_at(b32_chars, c3) + char_at(b32_chars, c4) + char_at(b32_chars, c5) + char_at(b32_chars, c6) + char_at(b32_chars, c7)
        end
        i += 5
    end
    return res
end

## Encodes an Alya string into standard Base32 representation with padding.
##
## ### Parameters
## - `s`: Input string.
##
## ### Returns
## Encoded Base32 string.
pub function base32_encode(s: str) -> str
    let slen = len(s)
    let bytes = []
    let i = 0
    while i < slen
        bytes.push(ord(char_at(s, i)))
        i += 1
    end
    return base32_encode_bytes(bytes, 1)
end

## Resolves numeric value of a Base32 character (case-insensitive).
pub function _b32_val(ch) -> int
    let c = ord(ch)
    when c
        is 65..90 then return c - 65      # A-Z -> 0-25
        is 97..122 then return c - 97     # a-z -> 0-25 (case-insensitive)
        is 50..55 then return c - 24      # 2-7 -> 26-31
        else return 255
    end
end

## Decodes a Base32 string into raw byte integers.
##
## ### Parameters
## - `s`: Base32 encoded string.
##
## ### Returns
## Array of byte integers.
pub function base32_decode_bytes(s: str) -> array
    let slen = len(s)
    let bytes = []
    let buf = 0
    let bits = 0
    let i = 0
    while i < slen
        let ch = char_at(s, i)
        if ch != "=" and ch != " " and ch != "\r" and ch != "\n"
            let val = _b32_val(ch)
            if val != 255
                buf = bit_or(bit_shl(buf, 5), val)
                bits += 5
                if bits >= 8
                    bits -= 8
                    let b = bit_and(bit_shr(buf, bits), 255)
                    bytes.push(b)
                end
            end
        end
        i += 1
    end
    return bytes
end

## Decodes a Base32 string back into an Alya string.
##
## ### Parameters
## - `s`: Base32 encoded string.
##
## ### Returns
## Decoded UTF-8 string.
pub function base32_decode(s: str) -> str
    let bytes = base32_decode_bytes(s)
    let res = ""
    let blen = len(bytes)
    let i = 0
    while i < blen
        res = res + chr(bytes[i])
        i += 1
    end
    return res
end

## Validates whether a string conforms to Base32 encoding syntax.
##
## ### Parameters
## - `s`: String to validate.
##
## ### Returns
## `1` if valid Base32, `0` otherwise.
pub function is_base32(s: str) -> int
    let slen = len(s)
    if slen == 0
        return 1
    end
    let i = 0
    while i < slen
        let ch = char_at(s, i)
        if ch != "=" and _b32_val(ch) == 255
            return 0
        end
        i += 1
    end
    return 1
end

## Alias for `base32_encode`.
pub function to_base32(s: str) -> str
    return base32_encode(s)
end

## Alias for `base32_decode`.
pub function from_base32(s: str) -> str
    return base32_decode(s)
end
