## Base64 Encoding & Decoding (RFC 4648)
##
## Part of the Alya Language package ecosystem (https://github.com/alya-lang).
## Standard Base64 text encoding and decoding routines.

## Encodes a byte array into a Base64 string with padding.
##
## ### Parameters
## - `bytes`: Byte array integers `[0..255]`.
##
## ### Returns
## Encoded Base64 string.
pub function base64_encode_bytes(bytes) -> str
    let b64_chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
    let blen = len(bytes)
    let res = ""
    let i = 0
    let b0, b1, b2 = 0
    let has_b1, has_b2 = 0
    let idx0, idx1, idx2, idx3 = 0

    while i < blen
        b0 = bytes[i]
        b1 = 0
        b2 = 0
        has_b1 = 0
        has_b2 = 0

        if i + 1 < blen
            b1 = bytes[i + 1]
            has_b1 = 1
        end
        if i + 2 < blen
            b2 = bytes[i + 2]
            has_b2 = 1
        end

        idx0 = bit_and(bit_shr(b0, 2), 63)
        idx1 = bit_and(bit_or(bit_shl(bit_and(b0, 3), 4), bit_shr(b1, 4)), 63)
        idx2 = bit_and(bit_or(bit_shl(bit_and(b1, 15), 2), bit_shr(b2, 6)), 63)
        idx3 = bit_and(b2, 63)

        res = res + char_at(b64_chars, idx0) + char_at(b64_chars, idx1)
        if has_b1 == 1
            res = res + char_at(b64_chars, idx2)
        else
            res = res + "="
        end
        if has_b2 == 1
            res = res + char_at(b64_chars, idx3)
        else
            res = res + "="
        end
        i += 3
    end
    return res
end

## Encodes an Alya string into standard Base64 representation.
##
## ### Parameters
## - `s`: Input string.
##
## ### Returns
## Encoded Base64 string.
pub function base64_encode(s: str) -> str
    let slen = len(s)
    let bytes = []
    let i = 0
    while i < slen
        bytes.push(ord(char_at(s, i)))
        i += 1
    end
    return base64_encode_bytes(bytes)
end

## Resolves numeric index of a Base64 character.
pub function _b64_val(ch) -> int
    let c = ord(ch)
    when c
        is 65..90 then return c - 65
        is 97..122 then return c - 71
        is 48..57 then return c + 4
        is 43 then return 62
        is 47 then return 63
        else return 0
    end
end

## Decodes a Base64 string into raw byte integers.
##
## ### Parameters
## - `s`: Base64 encoded string.
##
## ### Returns
## Array of byte integers.
pub function base64_decode_bytes(s: str) -> array
    let slen = len(s)
    let bytes = []
    let i = 0
    let v0, v1, v2, v3 = 0
    let b0, b1, b2 = 0
    let c0, c1, c2, c3 = ""

    while i + 3 < slen
        c0 = char_at(s, i)
        c1 = char_at(s, i + 1)
        c2 = char_at(s, i + 2)
        c3 = char_at(s, i + 3)

        v0 = _b64_val(c0)
        v1 = _b64_val(c1)
        v2 = _b64_val(c2)
        v3 = _b64_val(c3)

        b0 = bit_or(bit_shl(v0, 2), bit_and(bit_shr(v1, 4), 3))
        bytes.push(b0)

        if c2 != "="
            b1 = bit_and(bit_or(bit_shl(bit_and(v1, 15), 4), bit_shr(v2, 2)), 255)
            bytes.push(b1)
        end
        if c3 != "="
            b2 = bit_and(bit_or(bit_shl(bit_and(v2, 3), 6), v3), 255)
            bytes.push(b2)
        end
        i += 4
    end
    return bytes
end

## Decodes a Base64 string back into an Alya string.
##
## ### Parameters
## - `s`: Base64 encoded string.
##
## ### Returns
## Decoded UTF-8 string.
pub function base64_decode(s: str) -> str
    let bytes = base64_decode_bytes(s)
    let blen = len(bytes)
    let res = ""
    let i = 0
    while i < blen
        res = res + chr(bytes[i])
        i += 1
    end
    return res
end

## Validates whether a string conforms to Base64 syntax.
##
## ### Parameters
## - `s`: String to validate.
##
## ### Returns
## `1` if valid Base64, `0` otherwise.
pub function is_base64(s: str) -> int
    let slen = len(s)
    if slen == 0 or slen % 4 != 0
        return 0
    end
    let i = 0
    while i < slen
        let c = ord(char_at(s, i))
        let is_u = c >= 65 and c <= 90
        let is_l = c >= 97 and c <= 122
        let is_d = c >= 48 and c <= 57
        let is_plus_slash = c == 43 or c == 47
        let is_pad = c == 61
        if not is_u and not is_l and not is_d and not is_plus_slash and not is_pad
            return 0
        end
        i += 1
    end
    return 1
end
