# Low-level 32-bit and 64-bit bitwise rotation helpers
# Part of the Alya Language package ecosystem (https://github.com/alya-lang)

## Rotates a 32-bit word left by n bits.
pub function rotl32(x: int, n: int) -> int
    return bit_and(bit_or(bit_shl(x, n), bit_shr(x, 32 - n)), 4294967295)
end

## Rotates a 32-bit word right by n bits.
pub function rotr32(x: int, n: int) -> int
    return bit_and(bit_or(bit_shr(x, n), bit_shl(x, 32 - n)), 4294967295)
end

## Shifts a 32-bit word right by n bits.
pub function shr32(x: int, n: int) -> int
    return bit_and(bit_shr(x, n), 4294967295)
end

## Combines two 32-bit halves into a 64-bit word.
pub function u64(hi: int, lo: int) -> int
    return bit_or(bit_shl(hi, 32), lo)
end

## Rotates a 64-bit word left by n bits.
pub function rotl64(x: int, n: int) -> int
    if n == 0
        return x
    end
    return bit_or(bit_shl(x, n), bit_shr(x, 64 - n))
end

## Rotates a 64-bit word right by n bits.
pub function rotr64(x: int, n: int) -> int
    if n == 0
        return x
    end
    return bit_or(bit_shr(x, n), bit_shl(x, 64 - n))
end
