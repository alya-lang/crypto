## Cryptographic Security & Timing Attack Mitigation
##
## Part of the Alya Language package ecosystem (https://github.com/alya-lang).
## Provides constant-time equality comparisons to prevent timing side-channel attacks.

## Constant-time string equality check.
##
## Evaluates all characters regardless of mismatches to eliminate timing variance.
##
## ### Parameters
## - `a`: First string.
## - `b`: Second string.
##
## ### Returns
## `true` if strings are equal, `false` otherwise.
pub function constant_time_eq(a: str, b: str) -> bool
    let alen = len(a)
    let blen = len(b)
    if alen != blen
        return 0
    end
    let diff = 0
    let i = 0
    while i < alen
        diff = bit_or(diff, bit_xor(ord(char_at(a, i)), ord(char_at(b, i))))
        i += 1
    end
    return diff == 0
end

## Constant-time byte array equality check.
##
## Evaluates all array elements regardless of mismatches to eliminate timing variance.
##
## ### Parameters
## - `a`: First byte array.
## - `b`: Second byte array.
##
## ### Returns
## `true` if byte arrays are equal, `false` otherwise.
pub function constant_time_eq_bytes(a, b) -> bool
    let alen = len(a)
    let blen = len(b)
    if alen != blen
        return 0
    end
    let diff = 0
    let i = 0
    while i < alen
        diff = bit_or(diff, bit_xor(a[i], b[i]))
        i += 1
    end
    return diff == 0
end
