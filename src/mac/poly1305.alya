## Poly1305 One-Time Authenticator (RFC 8439)
##
## Part of the Alya Language package ecosystem (https://github.com/alya-lang).
## High-speed 128-bit message authentication code.

import "../core/security.alya"
import "../encodings/hex.alya"

## Reads 4 bytes as a little-endian u32.
pub function _u8to32(arr, offset: int) -> int
    let b0 = arr[offset]
    let b1 = arr[offset + 1]
    let b2 = arr[offset + 2]
    let b3 = arr[offset + 3]
    return bit_or(bit_or(b0, bit_shl(b1, 8)), bit_or(bit_shl(b2, 16), bit_shl(b3, 24)))
end

# Multiplies two limbs and accumulates L and H into acc_L and acc_H arrays
# A is at most 26 bits, B is at most 29 bits.
# A * B = L + H * 2^26 (safe against 32-bit integer overflow on all architectures)
function _acc_prod(a: int, b: int, acc_L: array, acc_H: array, idx: int)
    let a_lo = bit_and(a, 8191)
    let a_hi = bit_shr(a, 13)
    let b_lo = bit_and(b, 8191)
    let b_hi = bit_shr(b, 13)

    let p0 = a_lo * b_lo
    let p1 = a_hi * b_lo + a_lo * b_hi
    let p2 = a_hi * b_hi

    let p1_lo = bit_and(p1, 8191)
    let p1_hi = bit_shr(p1, 13)

    let l = p0 + bit_shl(p1_lo, 13)
    let h = p2 + p1_hi

    acc_L[idx] = acc_L[idx] + l
    acc_H[idx] = acc_H[idx] + h
end

## Computes 16-byte Poly1305 MAC tag from message byte array using 32-byte key.
##
## ### Parameters
## - `msg_bytes`: Input message byte array.
## - `key_bytes`: 32-byte secret one-time key array.
##
## ### Returns
## 16-element byte array containing the MAC tag.
pub function poly1305_mac_bytes(msg_bytes, key_bytes) -> array
    if len(key_bytes) < 32
        throw "Poly1305 key must be at least 32 bytes"
    end

    # 1. Clamp r
    let r0 = bit_and(_u8to32(key_bytes, 0), 67108863)
    let r1 = bit_and(bit_shr(_u8to32(key_bytes, 3), 2), 67108611)
    let r2 = bit_and(bit_shr(_u8to32(key_bytes, 6), 4), 67092735)
    let r3 = bit_and(bit_shr(_u8to32(key_bytes, 9), 6), 66076671)
    let r4 = bit_and(bit_shr(_u8to32(key_bytes, 12), 8), 1048575)

    let s1 = r1 * 5
    let s2 = r2 * 5
    let s3 = r3 * 5
    let s4 = r4 * 5

    let pad0 = _u8to32(key_bytes, 16)
    let pad1 = _u8to32(key_bytes, 20)
    let pad2 = _u8to32(key_bytes, 24)
    let pad3 = _u8to32(key_bytes, 28)

    let h0 = 0
    let h1 = 0
    let h2 = 0
    let h3 = 0
    let h4 = 0

    let mlen = len(msg_bytes)
    let offset = 0

    # Process full 16-byte blocks
    while offset + 16 <= mlen
        h0 += bit_and(_u8to32(msg_bytes, offset + 0), 67108863)
        h1 += bit_and(bit_shr(_u8to32(msg_bytes, offset + 3), 2), 67108863)
        h2 += bit_and(bit_shr(_u8to32(msg_bytes, offset + 6), 4), 67108863)
        h3 += bit_and(bit_shr(_u8to32(msg_bytes, offset + 9), 6), 67108863)
        h4 += bit_or(bit_shr(_u8to32(msg_bytes, offset + 12), 8), 16777216)

        let acc_L = [0, 0, 0, 0, 0]
        let acc_H = [0, 0, 0, 0, 0]

        _acc_prod(h0, r0, acc_L, acc_H, 0)
        _acc_prod(h1, s4, acc_L, acc_H, 0)
        _acc_prod(h2, s3, acc_L, acc_H, 0)
        _acc_prod(h3, s2, acc_L, acc_H, 0)
        _acc_prod(h4, s1, acc_L, acc_H, 0)

        _acc_prod(h0, r1, acc_L, acc_H, 1)
        _acc_prod(h1, r0, acc_L, acc_H, 1)
        _acc_prod(h2, s4, acc_L, acc_H, 1)
        _acc_prod(h3, s3, acc_L, acc_H, 1)
        _acc_prod(h4, s2, acc_L, acc_H, 1)

        _acc_prod(h0, r2, acc_L, acc_H, 2)
        _acc_prod(h1, r1, acc_L, acc_H, 2)
        _acc_prod(h2, r0, acc_L, acc_H, 2)
        _acc_prod(h3, s4, acc_L, acc_H, 2)
        _acc_prod(h4, s3, acc_L, acc_H, 2)

        _acc_prod(h0, r3, acc_L, acc_H, 3)
        _acc_prod(h1, r2, acc_L, acc_H, 3)
        _acc_prod(h2, r1, acc_L, acc_H, 3)
        _acc_prod(h3, r0, acc_L, acc_H, 3)
        _acc_prod(h4, s4, acc_L, acc_H, 3)

        _acc_prod(h0, r4, acc_L, acc_H, 4)
        _acc_prod(h1, r3, acc_L, acc_H, 4)
        _acc_prod(h2, r2, acc_L, acc_H, 4)
        _acc_prod(h3, r1, acc_L, acc_H, 4)
        _acc_prod(h4, r0, acc_L, acc_H, 4)

        let c = acc_H[0] + bit_shr(acc_L[0], 26)
        h0 = bit_and(acc_L[0], 67108863)

        let d1_val = acc_L[1] + c
        c = acc_H[1] + bit_shr(d1_val, 26)
        h1 = bit_and(d1_val, 67108863)

        let d2_val = acc_L[2] + c
        c = acc_H[2] + bit_shr(d2_val, 26)
        h2 = bit_and(d2_val, 67108863)

        let d3_val = acc_L[3] + c
        c = acc_H[3] + bit_shr(d3_val, 26)
        h3 = bit_and(d3_val, 67108863)

        let d4_val = acc_L[4] + c
        c = acc_H[4] + bit_shr(d4_val, 26)
        h4 = bit_and(d4_val, 67108863)

        h0 += c * 5
        c = bit_shr(h0, 26)
        h0 = bit_and(h0, 67108863)
        h1 += c

        offset += 16
    end

    # Process remaining leftover bytes (if any)
    if offset < mlen
        let buf = []
        let i = 0
        while offset + i < mlen
            buf.push(msg_bytes[offset + i])
            i += 1
        end
        buf.push(1)
        while len(buf) < 16
            buf.push(0)
        end

        h0 += bit_and(_u8to32(buf, 0), 67108863)
        h1 += bit_and(bit_shr(_u8to32(buf, 3), 2), 67108863)
        h2 += bit_and(bit_shr(_u8to32(buf, 6), 4), 67108863)
        h3 += bit_and(bit_shr(_u8to32(buf, 9), 6), 67108863)
        h4 += bit_shr(_u8to32(buf, 12), 8)

        let acc_L = [0, 0, 0, 0, 0]
        let acc_H = [0, 0, 0, 0, 0]

        _acc_prod(h0, r0, acc_L, acc_H, 0)
        _acc_prod(h1, s4, acc_L, acc_H, 0)
        _acc_prod(h2, s3, acc_L, acc_H, 0)
        _acc_prod(h3, s2, acc_L, acc_H, 0)
        _acc_prod(h4, s1, acc_L, acc_H, 0)

        _acc_prod(h0, r1, acc_L, acc_H, 1)
        _acc_prod(h1, r0, acc_L, acc_H, 1)
        _acc_prod(h2, s4, acc_L, acc_H, 1)
        _acc_prod(h3, s3, acc_L, acc_H, 1)
        _acc_prod(h4, s2, acc_L, acc_H, 1)

        _acc_prod(h0, r2, acc_L, acc_H, 2)
        _acc_prod(h1, r1, acc_L, acc_H, 2)
        _acc_prod(h2, r0, acc_L, acc_H, 2)
        _acc_prod(h3, s4, acc_L, acc_H, 2)
        _acc_prod(h4, s3, acc_L, acc_H, 2)

        _acc_prod(h0, r3, acc_L, acc_H, 3)
        _acc_prod(h1, r2, acc_L, acc_H, 3)
        _acc_prod(h2, r1, acc_L, acc_H, 3)
        _acc_prod(h3, r0, acc_L, acc_H, 3)
        _acc_prod(h4, s4, acc_L, acc_H, 3)

        _acc_prod(h0, r4, acc_L, acc_H, 4)
        _acc_prod(h1, r3, acc_L, acc_H, 4)
        _acc_prod(h2, r2, acc_L, acc_H, 4)
        _acc_prod(h3, r1, acc_L, acc_H, 4)
        _acc_prod(h4, r0, acc_L, acc_H, 4)

        let c = acc_H[0] + bit_shr(acc_L[0], 26)
        h0 = bit_and(acc_L[0], 67108863)

        let d1_val = acc_L[1] + c
        c = acc_H[1] + bit_shr(d1_val, 26)
        h1 = bit_and(d1_val, 67108863)

        let d2_val = acc_L[2] + c
        c = acc_H[2] + bit_shr(d2_val, 26)
        h2 = bit_and(d2_val, 67108863)

        let d3_val = acc_L[3] + c
        c = acc_H[3] + bit_shr(d3_val, 26)
        h3 = bit_and(d3_val, 67108863)

        let d4_val = acc_L[4] + c
        c = acc_H[4] + bit_shr(d4_val, 26)
        h4 = bit_and(d4_val, 67108863)

        h0 += c * 5
        c = bit_shr(h0, 26)
        h0 = bit_and(h0, 67108863)
        h1 += c
    end

    # Fully carry h
    let c = bit_shr(h1, 26)
    h1 = bit_and(h1, 67108863)
    h2 += c
    c = bit_shr(h2, 26)
    h2 = bit_and(h2, 67108863)
    h3 += c
    c = bit_shr(h3, 26)
    h3 = bit_and(h3, 67108863)
    h4 += c
    c = bit_shr(h4, 26)
    h4 = bit_and(h4, 67108863)
    h0 += c * 5
    c = bit_shr(h0, 26)
    h0 = bit_and(h0, 67108863)
    h1 += c

    # Compute h - p
    let g0 = h0 + 5
    c = bit_shr(g0, 26)
    g0 = bit_and(g0, 67108863)
    let g1 = h1 + c
    c = bit_shr(g1, 26)
    g1 = bit_and(g1, 67108863)
    let g2 = h2 + c
    c = bit_shr(g2, 26)
    g2 = bit_and(g2, 67108863)
    let g3 = h3 + c
    c = bit_shr(g3, 26)
    g3 = bit_and(g3, 67108863)
    let g4 = h4 + c - 67108864

    if g4 >= 0
        h0 = g0
        h1 = g1
        h2 = g2
        h3 = g3
        h4 = bit_and(g4, 67108863)
    end

    # h = h % 2^128 (repack into 4 32-bit integers)
    let out0 = bit_and(bit_or(h0, bit_shl(h1, 26)), 4294967295)
    let out1 = bit_and(bit_or(bit_shr(h1, 6), bit_shl(h2, 20)), 4294967295)
    let out2 = bit_and(bit_or(bit_shr(h2, 12), bit_shl(h3, 14)), 4294967295)
    let out3 = bit_and(bit_or(bit_shr(h3, 18), bit_shl(h4, 8)), 4294967295)

    # mac = (h + pad) % 2^128 using 16-bit safe addition without 32-bit overflow
    let lo0 = bit_and(out0, 65535) + bit_and(pad0, 65535)
    let hi0 = bit_shr(out0, 16) + bit_shr(pad0, 16) + bit_shr(lo0, 16)
    let carry = bit_shr(hi0, 16)
    out0 = bit_or(bit_and(lo0, 65535), bit_shl(bit_and(hi0, 65535), 16))

    let lo1 = bit_and(out1, 65535) + bit_and(pad1, 65535) + carry
    let hi1 = bit_shr(out1, 16) + bit_shr(pad1, 16) + bit_shr(lo1, 16)
    carry = bit_shr(hi1, 16)
    out1 = bit_or(bit_and(lo1, 65535), bit_shl(bit_and(hi1, 65535), 16))

    let lo2 = bit_and(out2, 65535) + bit_and(pad2, 65535) + carry
    let hi2 = bit_shr(out2, 16) + bit_shr(pad2, 16) + bit_shr(lo2, 16)
    carry = bit_shr(hi2, 16)
    out2 = bit_or(bit_and(lo2, 65535), bit_shl(bit_and(hi2, 65535), 16))

    let lo3 = bit_and(out3, 65535) + bit_and(pad3, 65535) + carry
    let hi3 = bit_shr(out3, 16) + bit_shr(pad3, 16) + bit_shr(lo3, 16)
    out3 = bit_or(bit_and(lo3, 65535), bit_shl(bit_and(hi3, 65535), 16))

    let mac = []
    mac.push(bit_and(out0, 255))
    mac.push(bit_and(bit_shr(out0, 8), 255))
    mac.push(bit_and(bit_shr(out0, 16), 255))
    mac.push(bit_and(bit_shr(out0, 24), 255))

    mac.push(bit_and(out1, 255))
    mac.push(bit_and(bit_shr(out1, 8), 255))
    mac.push(bit_and(bit_shr(out1, 16), 255))
    mac.push(bit_and(bit_shr(out1, 24), 255))

    mac.push(bit_and(out2, 255))
    mac.push(bit_and(bit_shr(out2, 8), 255))
    mac.push(bit_and(bit_shr(out2, 16), 255))
    mac.push(bit_and(bit_shr(out2, 24), 255))

    mac.push(bit_and(out3, 255))
    mac.push(bit_and(bit_shr(out3, 8), 255))
    mac.push(bit_and(bit_shr(out3, 16), 255))
    mac.push(bit_and(bit_shr(out3, 24), 255))

    return mac
end

## Computes 32-character lowercase hex Poly1305 MAC tag from message string.
##
## ### Parameters
## - `msg_str`: Input message string.
## - `key_bytes`: 32-byte secret one-time key array.
##
## ### Returns
## 32-character lowercase hex MAC tag string.
pub function poly1305_mac(msg_str: str, key_bytes) -> str
    let m_bytes = str_to_bytes(msg_str)
    let tag = poly1305_mac_bytes(m_bytes, key_bytes)
    return bytes_to_hex(tag)
end

## Verifies a Poly1305 MAC tag in constant time.
##
## ### Parameters
## - `msg_str`: Input message string.
## - `key_bytes`: 32-byte secret one-time key array.
## - `expected_tag_hex`: Expected 32-character hex MAC tag.
##
## ### Returns
## `true` if MAC matches, `false` otherwise.
pub function poly1305_verify(msg_str: str, key_bytes, expected_tag_hex: str) -> bool
    let computed_tag_hex = poly1305_mac(msg_str, key_bytes)
    return constant_time_eq(computed_tag_hex, expected_tag_hex)
end
