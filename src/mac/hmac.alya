# HMAC-MD5
# ═══════════════════════════════════════════════════════════════

## Computes HMAC-MD5 of byte message using byte key, returning 16 raw bytes.
##
## ### Parameters
## - `key_bytes`: Secret key byte array.
## - `msg_bytes`: Input message byte array.
##
## ### Returns
## 16-element byte array containing the HMAC digest.
pub function hmac_md5_bytes(key_bytes, msg_bytes) -> array
    let k = []
    let klen = len(key_bytes)

    if klen > 64
        k = md5_bytes(key_bytes)
    else
        let i = 0
        while i < klen
            k.push(key_bytes[i])
            i += 1
        end
    end

    while len(k) < 64
        k.push(0)
    end

    let k_ipad = []
    let k_opad = []
    let i = 0
    while i < 64
        let b = k[i]
        k_ipad.push(bit_xor(b, 54))
        k_opad.push(bit_xor(b, 92))
        i += 1
    end

    let inner_data = []
    i = 0
    while i < 64
        inner_data.push(k_ipad[i])
        i += 1
    end
    let j = 0
    let mlen = len(msg_bytes)
    while j < mlen
        inner_data.push(msg_bytes[j])
        j += 1
    end

    let inner_hash = md5_bytes(inner_data)

    let outer_data = []
    i = 0
    while i < 64
        outer_data.push(k_opad[i])
        i += 1
    end
    j = 0
    while j < 16
        outer_data.push(inner_hash[j])
        j += 1
    end

    return md5_bytes(outer_data)
end

## Computes HMAC-MD5 of a string message using string key, returning lowercase hex.
##
## ### Parameters
## - `key_str`: Secret key string.
## - `msg_str`: Input message string.
##
## ### Returns
## 32-character lowercase hex digest string.
pub function hmac_md5_hex(key_str: str, msg_str: str) -> str
    let k_bytes = str_to_bytes(key_str)
    let m_bytes = str_to_bytes(msg_str)
    let digest = hmac_md5_bytes(k_bytes, m_bytes)
    return bytes_to_hex(digest)
end

## Computes HMAC-MD5 of a string message. Alias for `hmac_md5_hex`.
##
## ### Parameters
## - `key_str`: Secret key string.
## - `msg_str`: Input message string.
##
## ### Returns
## 32-character lowercase hex digest string.
pub function hmac_md5(key_str: str, msg_str: str) -> str
    return hmac_md5_hex(key_str, msg_str)
end

# ═══════════════════════════════════════════════════════════════
# HMAC-SHA512
# ═══════════════════════════════════════════════════════════════

## Computes HMAC-SHA512 of byte message using byte key, returning 64 raw bytes.
##
## ### Parameters
## - `key_bytes`: Secret key byte array.
## - `msg_bytes`: Input message byte array.
##
## ### Returns
## 64-element byte array containing the HMAC digest.
pub function hmac_sha512_bytes(key_bytes, msg_bytes) -> array
    let k = []
    let klen = len(key_bytes)

    if klen > 128
        k = sha512_bytes(key_bytes)
    else
        let i = 0
        while i < klen
            k.push(key_bytes[i])
            i += 1
        end
    end

    while len(k) < 128
        k.push(0)
    end

    let k_ipad = []
    let k_opad = []
    let i = 0
    while i < 128
        let b = k[i]
        k_ipad.push(bit_xor(b, 54))
        k_opad.push(bit_xor(b, 92))
        i += 1
    end

    let inner_data = []
    i = 0
    while i < 128
        inner_data.push(k_ipad[i])
        i += 1
    end
    let j = 0
    let mlen = len(msg_bytes)
    while j < mlen
        inner_data.push(msg_bytes[j])
        j += 1
    end

    let inner_hash = sha512_bytes(inner_data)

    let outer_data = []
    i = 0
    while i < 128
        outer_data.push(k_opad[i])
        i += 1
    end
    j = 0
    while j < 64
        outer_data.push(inner_hash[j])
        j += 1
    end

    return sha512_bytes(outer_data)
end

## Computes HMAC-SHA512 of a string message using string key, returning lowercase hex.
##
## ### Parameters
## - `key_str`: Secret key string.
## - `msg_str`: Input message string.
##
## ### Returns
## 128-character lowercase hex digest string.
pub function hmac_sha512_hex(key_str: str, msg_str: str) -> str
    let k_bytes = str_to_bytes(key_str)
    let m_bytes = str_to_bytes(msg_str)
    let digest = hmac_sha512_bytes(k_bytes, m_bytes)
    return bytes_to_hex(digest)
end

## Computes HMAC-SHA512 of a string message. Alias for `hmac_sha512_hex`.
##
## ### Parameters
## - `key_str`: Secret key string.
## - `msg_str`: Input message string.
##
## ### Returns
## 128-character lowercase hex digest string.
pub function hmac_sha512(key_str: str, msg_str: str) -> str
    return hmac_sha512_hex(key_str, msg_str)
end

# ═══════════════════════════════════════════════════════════════
# HMAC-SHA384
# ═══════════════════════════════════════════════════════════════

## Computes HMAC-SHA384 of byte message using byte key, returning 48 raw bytes.
##
## ### Parameters
## - `key_bytes`: Secret key byte array.
## - `msg_bytes`: Input message byte array.
##
## ### Returns
## 48-element byte array containing the HMAC digest.
pub function hmac_sha384_bytes(key_bytes, msg_bytes) -> array
    let k = []
    let klen = len(key_bytes)

    if klen > 128
        k = sha384_bytes(key_bytes)
    else
        let i = 0
        while i < klen
            k.push(key_bytes[i])
            i += 1
        end
    end

    while len(k) < 128
        k.push(0)
    end

    let k_ipad = []
    let k_opad = []
    let i = 0
    while i < 128
        let b = k[i]
        k_ipad.push(bit_xor(b, 54))
        k_opad.push(bit_xor(b, 92))
        i += 1
    end

    let inner_data = []
    i = 0
    while i < 128
        inner_data.push(k_ipad[i])
        i += 1
    end
    let j = 0
    let mlen = len(msg_bytes)
    while j < mlen
        inner_data.push(msg_bytes[j])
        j += 1
    end

    let inner_hash = sha384_bytes(inner_data)

    let outer_data = []
    i = 0
    while i < 128
        outer_data.push(k_opad[i])
        i += 1
    end
    j = 0
    while j < 48
        outer_data.push(inner_hash[j])
        j += 1
    end

    return sha384_bytes(outer_data)
end

## Computes HMAC-SHA384 of a string message using string key, returning lowercase hex.
##
## ### Parameters
## - `key_str`: Secret key string.
## - `msg_str`: Input message string.
##
## ### Returns
## 96-character lowercase hex digest string.
pub function hmac_sha384_hex(key_str: str, msg_str: str) -> str
    let k_bytes = str_to_bytes(key_str)
    let m_bytes = str_to_bytes(msg_str)
    let digest = hmac_sha384_bytes(k_bytes, m_bytes)
    return bytes_to_hex(digest)
end

## Computes HMAC-SHA384 of a string message. Alias for `hmac_sha384_hex`.
##
## ### Parameters
## - `key_str`: Secret key string.
## - `msg_str`: Input message string.
##
## ### Returns
## 96-character lowercase hex digest string.
pub function hmac_sha384(key_str: str, msg_str: str) -> str
    return hmac_sha384_hex(key_str, msg_str)
end
