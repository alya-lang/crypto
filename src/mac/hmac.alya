end

# --- HMAC-SHA512 ---

pub function hmac_sha512_bytes(key_bytes, msg_bytes)
    let k = []
    let klen = len(key_bytes)

    if klen > 128
        k = sha512_bytes(key_bytes)
    else
        let i = 0
        while i < klen
            k.push(key_bytes[i])
            i += 1
        end
    end

    while len(k) < 128
        k.push(0)
    end

    let k_ipad = []
    let k_opad = []
    let i = 0
    while i < 128
        let b = k[i]
        k_ipad.push(bit_xor(b, 54))
        k_opad.push(bit_xor(b, 92))
        i += 1
    end

    let inner_data = []
    i = 0
    while i < 128
        inner_data.push(k_ipad[i])
        i += 1
    end
    let j = 0
    let mlen = len(msg_bytes)
    while j < mlen
        inner_data.push(msg_bytes[j])
        j += 1
    end

    let inner_hash = sha512_bytes(inner_data)

    let outer_data = []
    i = 0
    while i < 128
        outer_data.push(k_opad[i])
        i += 1
    end
    j = 0
    while j < 64
        outer_data.push(inner_hash[j])
        j += 1
    end

    return sha512_bytes(outer_data)
end

pub function hmac_sha512_hex(key_str, msg_str)
    let k_bytes = str_to_bytes(key_str)
    let m_bytes = str_to_bytes(msg_str)
    let digest = hmac_sha512_bytes(k_bytes, m_bytes)
    return bytes_to_hex(digest)
end

pub function hmac_sha512(key_str, msg_str)
    return hmac_sha512_hex(key_str, msg_str)
end

# --- HMAC-SHA384 ---

pub function hmac_sha384_bytes(key_bytes, msg_bytes)
    let k = []
    let klen = len(key_bytes)

    if klen > 128
        k = sha384_bytes(key_bytes)
    else
        let i = 0
        while i < klen
            k.push(key_bytes[i])
            i += 1
        end
    end

    while len(k) < 128
        k.push(0)
    end

    let k_ipad = []
    let k_opad = []
    let i = 0
    while i < 128
        let b = k[i]
        k_ipad.push(bit_xor(b, 54))
        k_opad.push(bit_xor(b, 92))
        i += 1
    end

    let inner_data = []
    i = 0
    while i < 128
        inner_data.push(k_ipad[i])
        i += 1
    end
    let j = 0
    let mlen = len(msg_bytes)
    while j < mlen
        inner_data.push(msg_bytes[j])
        j += 1
    end

    let inner_hash = sha384_bytes(inner_data)

    let outer_data = []
    i = 0
    while i < 128
        outer_data.push(k_opad[i])
        i += 1
    end
    j = 0
    while j < 48
        outer_data.push(inner_hash[j])
        j += 1
    end

    return sha384_bytes(outer_data)
end

pub function hmac_sha384_hex(key_str, msg_str)
    let k_bytes = str_to_bytes(key_str)
    let m_bytes = str_to_bytes(msg_str)
    let digest = hmac_sha384_bytes(k_bytes, m_bytes)
    return bytes_to_hex(digest)
end

pub function hmac_sha384(key_str, msg_str)
    return hmac_sha384_hex(key_str, msg_str)
end
