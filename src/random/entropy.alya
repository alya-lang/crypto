# Entropy and Randomness Utilities
# Part of the Alya Language package ecosystem (https://github.com/alya-lang)

import "rand" as rand
import "../encodings/hex.alya"

function random_bytes(count)
    return rand::bytes(count)
end

function random_hex(count)
    let b = random_bytes(count)
    return bytes_to_hex(b)
end
