# Entropy and Randomness Utilities
# Part of the Alya Language package ecosystem (https://github.com/alya-lang)

import "rand" as rand

function random_bytes(count)
    return rand::bytes(count)
end

function random_hex(count)
    return rand::hex(count * 2)
end

function random_uuid()
    return rand::uuid_v4()
end

