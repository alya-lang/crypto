# Benchmark suite for crypto
import "std/bench"
import "../src/lib.alya" as crypto

function main()
    let runner = bench_runner("crypto Micro-Benchmarks")

    # 1. SHA-256
    bench_start(runner, 2000)
    let i = 0
    let msg = "The quick brown fox jumps over the lazy dog"
    while i < 2000
        crypto::sha256(msg)
        i += 1
    end
    bench_stop(runner, "sha256() 2,000 hashes")

    # 2. SHA-1
    bench_start(runner, 2000)
    let j = 0
    while j < 2000
        crypto::sha1(msg)
        j += 1
    end
    bench_stop(runner, "sha1() 2,000 hashes")

    # 3. MD5
    bench_start(runner, 2000)
    let k = 0
    while k < 2000
        crypto::md5(msg)
        k += 1
    end
    bench_stop(runner, "md5() 2,000 hashes")

    # 4. HMAC-SHA256
    bench_start(runner, 1000)
    let m = 0
    let key = "secret-hmac-key"
    while m < 1000
        crypto::hmac_sha256(key, msg)
        m += 1
    end
    bench_stop(runner, "hmac_sha256() 1,000 operations")

    # 5. Base64 encode
    bench_start(runner, 5000)
    let n = 0
    while n < 5000
        crypto::base64_encode(msg)
        n += 1
    end
    bench_stop(runner, "base64_encode() 5,000 operations")

    bench_summary(runner)
end

main()
