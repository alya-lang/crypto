# Comprehensive Benchmark suite for crypto v0.1.0
import "std/bench"
import "../src/lib.alya" as crypto

function main()
    let runner = bench_runner("crypto Micro-Benchmarks v0.1.0")

    let msg = "The quick brown fox jumps over the lazy dog"

    # 1. SHA-256
    bench_start(runner, 2000)
    let i = 0
    while i < 2000
        crypto::sha256(msg)
        i += 1
    end
    bench_stop(runner, "sha256() 2,000 hashes")

    # 2. SHA-512
    bench_start(runner, 1000)
    let s5 = 0
    while s5 < 1000
        crypto::sha512(msg)
        s5 += 1
    end
    bench_stop(runner, "sha512() 1,000 hashes")

    # 3. SHA-1
    bench_start(runner, 2000)
    let j = 0
    while j < 2000
        crypto::sha1(msg)
        j += 1
    end
    bench_stop(runner, "sha1() 2,000 hashes")

    # 4. MD5
    bench_start(runner, 2000)
    let k = 0
    while k < 2000
        crypto::md5(msg)
        k += 1
    end
    bench_stop(runner, "md5() 2,000 hashes")

    # 5. HMAC-SHA256
    bench_start(runner, 1000)
    let m = 0
    let key = "secret-hmac-key"
    while m < 1000
        crypto::hmac_sha256(key, msg)
        m += 1
    end
    bench_stop(runner, "hmac_sha256() 1,000 operations")

    # 6. Base64 Encode
    bench_start(runner, 5000)
    let n = 0
    while n < 5000
        crypto::base64_encode(msg)
        n += 1
    end
    bench_stop(runner, "base64_encode() 5,000 operations")

    # 7. Base32 Encode (RFC 4648)
    bench_start(runner, 2000)
    let b32_i = 0
    while b32_i < 2000
        crypto::base32_encode(msg)
        b32_i += 1
    end
    bench_stop(runner, "base32_encode() 2,000 operations")

    # 8. Base58 Encode (Bitcoin)
    bench_start(runner, 1000)
    let b58_i = 0
    while b58_i < 1000
        crypto::base58_encode(msg)
        b58_i += 1
    end
    bench_stop(runner, "base58_encode() 1,000 operations")

    # 9. RC4 Stream Cipher
    bench_start(runner, 2000)
    let rc4_i = 0
    while rc4_i < 2000
        crypto::rc4_encrypt("Key", msg)
        rc4_i += 1
    end
    bench_stop(runner, "rc4_encrypt() 2,000 operations")

    # 10. ChaCha20 Stream Cipher (RFC 8439)
    let cc_k = crypto::hex_to_bytes("000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f")
    let cc_n = crypto::hex_to_bytes("000000090000004a00000000")
    bench_start(runner, 1000)
    let cc_i = 0
    while cc_i < 1000
        crypto::chacha20_encrypt(cc_k, cc_n, 1, msg)
        cc_i += 1
    end
    bench_stop(runner, "chacha20_encrypt() 1,000 operations")

    # 11. AES-128-CTR Mode
    let aes_k = crypto::hex_to_bytes("2b7e151628aed2a6abf7158809cf4f3c")
    let aes_iv = crypto::hex_to_bytes("000102030405060708090a0b0c0d0e0f")
    bench_start(runner, 500)
    let aes_i = 0
    while aes_i < 500
        crypto::aes_ctr_encrypt(aes_k, aes_iv, msg)
        aes_i += 1
    end
    bench_stop(runner, "aes_ctr_encrypt() 500 operations")

    # 12. HKDF Key Derivation
    let salt_hex = "000102030405060708090a0b0c"
    let ikm_hex = "0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b"
    let info_hex = "f0f1f2f3f4f5f6f7f8f9"
    bench_start(runner, 500)
    let hkdf_i = 0
    while hkdf_i < 500
        crypto::hkdf_hex(salt_hex, ikm_hex, info_hex, 32)
        hkdf_i += 1
    end
    bench_stop(runner, "hkdf_hex() 500 operations")

    # 13. Poly1305 (RFC 8439)
    let poly_k = crypto::hex_to_bytes("85d6be7857556d337f4452fe42d506a80103808afb0db2fd4abff6af4149f51b")
    bench_start(runner, 2000)
    let p_i = 0
    while p_i < 2000
        crypto::poly1305_mac(msg, poly_k)
        p_i += 1
    end
    bench_stop(runner, "poly1305_mac() 2,000 operations")

    # 14. ChaCha20-Poly1305 AEAD
    let aead_aad_b = crypto::hex_to_bytes("50515253c0c1c2c3c4c5c6c7")
    let aead_pt_b = crypto::str_to_bytes(msg)
    bench_start(runner, 1000)
    let aead_i = 0
    while aead_i < 1000
        crypto::chacha20_poly1305_encrypt_bytes(cc_k, cc_n, aead_aad_b, aead_pt_b)
        aead_i += 1
    end
    bench_stop(runner, "chacha20_poly1305_encrypt() 1,000 operations")

    # 15. BLAKE2s (RFC 7693)
    bench_start(runner, 2000)
    let b2s_i = 0
    while b2s_i < 2000
        crypto::blake2s(msg)
        b2s_i += 1
    end
    bench_stop(runner, "blake2s() 2,000 hashes")

    # 16. SHA3-256 (FIPS 202)
    bench_start(runner, 500)
    let sha3_i = 0
    while sha3_i < 500
        crypto::sha3_256(msg)
        sha3_i += 1
    end
    bench_stop(runner, "sha3_256() 500 hashes")

    # 17. AES-128-GCM AEAD (NIST SP 800-38D)
    let gcm_k = crypto::hex_to_bytes("00000000000000000000000000000000")
    let gcm_n = crypto::hex_to_bytes("000000000000000000000000")
    let gcm_pt = crypto::str_to_bytes(msg)
    bench_start(runner, 500)
    let gcm_i = 0
    while gcm_i < 500
        crypto::aes_gcm_encrypt_bytes(gcm_k, gcm_n, aead_aad_b, gcm_pt)
        gcm_i += 1
    end
    bench_stop(runner, "aes_gcm_encrypt() 500 operations")

    # 18. X25519 key exchange (RFC 7748)
    let x_k = crypto::hex_to_bytes("484a7fbaf7ed93e344655d4876ac161b59ad8193d1400fd70db7c0871dfb6553")
    let x_p = crypto::hex_to_bytes("92cd0068c67b67bec749d80de23c426abeb9a34b9bacfc309237e4cfc62ba154")
    bench_start(runner, 20)
    let x_i = 0
    while x_i < 20
        crypto::x25519(x_k, x_p)
        x_i += 1
    end
    bench_stop(runner, "x25519() 20 exchanges")

    # 19. 2048-bit modular exponentiation (RSAcore)
    let mexp_base = crypto::bi_from_bytes(crypto::hex_to_bytes("075bcd15"))
    let mexp_mod = crypto::bi_sub(crypto::bi_shl([1], 128, 0), crypto::bi_from_bytes(crypto::hex_to_bytes("1da311")))
    bench_start(runner, 20)
    let mexp_i = 0
    while mexp_i < 20
        crypto::bi_modexp_int(mexp_base, 65537, mexp_mod)
        mexp_i += 1
    end
    bench_stop(runner, "bi_modexp_int() 2048-bit 20 ops")

    bench_summary(runner)
end

main()
